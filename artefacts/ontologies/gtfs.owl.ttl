:BookingRule a owl:Class ;
    rdfs:subClassOf owl:Thing .

:CalendarDateService a owl:Class ;
    rdfs:subClassOf :Service ;
    owl:hasKey ( :service_id :date ) .

:dateType a rdfs:Datatype ;
    rdfs:label "date"@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^\\d{4}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])$"^^xsd:string ] ) ] .

:hasParentStation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :Stop ;
    rdfs:range :Stop ;
    owl:inverseOf :isParentStationOf .

:stop_lat a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Stop ;
    rdfs:range :latitude .

:stop_lon a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Stop ;
    rdfs:range :longitude .

:stop_name a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Stop ;
    rdfs:range :text .

:StopOrPlatform a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :stop_lon ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :stop_name ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :stop_lat ],
        :Stop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Stop [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:hasValue 0 ;
                                    owl:onProperty :location_type ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :location_type ] ) ] ) ] .

:time a rdfs:Datatype ;
    rdfs:label "time"@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^\\d+:[0-5]\\d:[0-5]\\d$"^^xsd:string ] ) ] .

:url a rdfs:Datatype ;
    rdfs:label "url"@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^https?:\\/\\/(?:www\\.)?[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(?:\\/[^\\s]*)?$"^^xsd:string ] ) ] .

:ChildStop a owl:Class ;
    rdfs:subClassOf :Stop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Stop [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :hasParentStation ] ) ] .

:Service a owl:Class ;
    rdfs:subClassOf owl:Thing .

:location_type a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Stop ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 3 4 ) ] .

:id a rdfs:Datatype ;
    rdfs:label "id"@en ;
    owl:equivalentClass xsd:string .

:CalendarService a owl:Class ;
    rdfs:subClassOf :Service ;
    owl:disjointWith :CalendarDateService ;
    owl:hasKey ( :service_id ) .

:Agency a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    owl:hasKey ( :agency_id ) .

:text a rdfs:Datatype ;
    rdfs:label "text"@en .

:Trip a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    owl:hasKey ( :trip_id ) .

:Route a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    owl:hasKey ( :route_id ) .

:StopTime a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    owl:hasKey ( :stop_sequence :hasTrip ) .

:Stop a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    owl:hasKey ( :stop_id ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :StopLocation :Platform :Station :EntranceOrExit :GenericNode :BoardingArea ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Agency :Stop :Route :Trip :StopTime :Service :Level :Shape :LocationGroup :Location :BookingRule ) .

