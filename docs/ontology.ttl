                            ) .


###  https://transit.ac.uk/ontologies/gtfs#ChildStop
:ChildStop rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :Stop
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :hasParentStation ;
                                                        owl:cardinality "1"^^xsd:nonNegativeInteger
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :Stop ;
           owl:disjointWith :ParentlessStop .


###  https://transit.ac.uk/ontologies/gtfs#EntranceOrExit
:EntranceOrExit rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Stop
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :location_type ;
                                                             owl:hasValue 2
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :ChildStop ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :stop_lat ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :stop_lon ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :stop_name ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] .


###  https://transit.ac.uk/ontologies/gtfs#GenericNode
:GenericNode rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Stop
