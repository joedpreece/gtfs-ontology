#################################################################
#    Classes
#################################################################

###  https://transit.ac.uk/ontologies/gtfs#Agency
:Agency rdf:type owl:Class ;
        rdfs:subClassOf owl:Thing ;
        owl:hasKey ( :agency_id
                   ) .


###  https://transit.ac.uk/ontologies/gtfs#BoardingArea
:BoardingArea rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Stop
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :location_type ;
                                                           owl:hasValue 4
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
