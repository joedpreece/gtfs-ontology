#################################################################
#    Data properties
#################################################################

###  https://transit.ac.uk/ontologies/gtfs#agency_email
:agency_email rdf:type owl:DatatypeProperty ;
              rdfs:domain :Agency ;
              rdfs:range xsd:string ;
              rdfs:comment "Email address actively monitored by the agency’s customer service department. This email address should be a direct contact point where transit riders can reach a customer service representative at the agency."@en .


###  https://transit.ac.uk/ontologies/gtfs#agency_fare_url
:agency_fare_url rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Agency ;
                 rdfs:range xsd:string ;
                 rdfs:comment "URL of a web page where a rider can purchase tickets or other fare instruments for that agency, or a web page containing information about that agency's fares."@en .


###  https://transit.ac.uk/ontologies/gtfs#agency_id
:agency_id rdf:type owl:DatatypeProperty ;
           rdfs:domain :Agency ;
           rdfs:range xsd:string ;
           rdfs:comment "Identifies a transit brand which is often synonymous with a transit agency. Note that in some cases, such as when a single agency operates multiple separate services, agencies and brands are distinct. This [ontology] uses the term \"agency\" in place of \"brand\". A dataset may contain data from multiple agencies."@en .


###  https://transit.ac.uk/ontologies/gtfs#agency_lang
:agency_lang rdf:type owl:DatatypeProperty ;
             rdfs:domain :Agency ;
             rdfs:range xsd:string ;
             rdfs:comment "Primary language used by this transit agency. Should be provided to help GTFS consumers choose capitalization rules and other language-specific settings for the dataset."@en .


###  https://transit.ac.uk/ontologies/gtfs#agency_name
:agency_name rdf:type owl:DatatypeProperty ;
             rdfs:domain :Agency ;
             rdfs:range xsd:string ;
             rdfs:comment "Full name of the transit agency."@en .


###  https://transit.ac.uk/ontologies/gtfs#agency_phone
:agency_phone rdf:type owl:DatatypeProperty ;
              rdfs:domain :Agency ;
              rdfs:range xsd:string ;
              rdfs:comment "A voice telephone number for the specified agency. This field is a string value that presents the telephone number as typical for the agency's service area. It may contain punctuation marks to group the digits of the number. Dialable text (for example, TriMet's \"503-238-RIDE\") is permitted, but the field must not contain any other descriptive text."@en .


###  https://transit.ac.uk/ontologies/gtfs#agency_timezone
:agency_timezone rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Agency ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Timezone where the transit agency is located. If multiple agencies are specified in the dataset, each must have the same agency_timezone."@en .


###  https://transit.ac.uk/ontologies/gtfs#agency_url
:agency_url rdf:type owl:DatatypeProperty ;
            rdfs:domain :Agency ;
            rdfs:range xsd:string ;
            rdfs:comment "URL of the transit agency."@en .


###  https://transit.ac.uk/ontologies/gtfs#arrival_time
:arrival_time rdf:type owl:DatatypeProperty ;
              rdfs:domain :StopTime ;
              rdfs:range xsd:time .


###  https://transit.ac.uk/ontologies/gtfs#bikes_allowed
:bikes_allowed rdf:type owl:DatatypeProperty ;
               rdfs:domain :Trip ;
               rdfs:range xsd:integer .


###  https://transit.ac.uk/ontologies/gtfs#block_id
:block_id rdf:type owl:DatatypeProperty ;
          rdfs:domain :Trip ;
          rdfs:range xsd:integer .


###  https://transit.ac.uk/ontologies/gtfs#cars_allowed
:cars_allowed rdf:type owl:DatatypeProperty ;
              rdfs:domain :Trip ;
              rdfs:range xsd:integer .


###  https://transit.ac.uk/ontologies/gtfs#cemv_support
:cemv_support rdf:type owl:DatatypeProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Agency
                                          :Route
                                        )
                          ] ;
              rdfs:range xsd:integer ;
              rdfs:comment "Indicates if riders can access a transit service (i.e., trip) associated with this agency by using a contactless EMV (Europay, Mastercard, and Visa) card or mobile device as fare media at a fare validator (such as in pay-as-you-go or open-loop systems). This field does not indicate that cEMV can be used to purchase other fare products or to add value to another fare media.\\n Support for cEMVs should only be indicated if all services under this agency are accessible with the use of cEMV cards or mobile devices as fare media."@en .


###  https://transit.ac.uk/ontologies/gtfs#continuous_drop_off
:continuous_drop_off rdf:type owl:DatatypeProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :Route
                                                 :StopTime
                                               )
                                 ] ;
                     rdfs:range xsd:integer .


###  https://transit.ac.uk/ontologies/gtfs#continuous_pickup
:continuous_pickup rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Route
                                               :StopTime
                                             )
                               ] ;
                   rdfs:range xsd:integer .


