                                                         rdf:rest [ rdf:type rdf:List ;
                                                                    rdf:first 2 ;
                                                                    rdf:rest [ rdf:type rdf:List ;
                                                                               rdf:first 3 ;
                                                                               rdf:rest rdf:nil
                                                                             ]
                                                                  ]
                                                       ]
                                            ]
                                ] .


