:Platform rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :ChildStop
                                                     :StopOrPlatform
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
          rdfs:subClassOf :StopOrPlatform .


