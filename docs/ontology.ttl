###  https://transit.ac.uk/ontologies/gtfs#ParentlessStop
:ParentlessStop rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Stop
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :hasParentStation ;
                                                             owl:cardinality "0"^^xsd:nonNegativeInteger
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :Stop .


