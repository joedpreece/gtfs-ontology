###  https://transit.ac.uk/ontologies/gtfs#Station
:Station rdf:type owl:Class ;
         owl:equivalentClass [ owl:intersectionOf ( :Stop
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :location_type ;
                                                      owl:hasValue 1
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
         rdfs:subClassOf :ParentlessStop ,
                         [ rdf:type owl:Restriction ;
