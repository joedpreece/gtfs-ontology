###  https://transit.ac.uk/ontologies/gtfs#drop_off_booking_rule_id
:drop_off_booking_rule_id rdf:type owl:ObjectProperty ;
                          rdfs:domain :StopTime ;
                          rdfs:range :BookingRule .


###  https://transit.ac.uk/ontologies/gtfs#hasLevel
:hasLevel rdf:type owl:ObjectProperty ;
          rdfs:domain :Stop ;
          rdfs:range :Level .


###  https://transit.ac.uk/ontologies/gtfs#hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             rdfs:domain :StopTime ;
             rdfs:range :Location .


###  https://transit.ac.uk/ontologies/gtfs#hasLocationGroup
:hasLocationGroup rdf:type owl:ObjectProperty ;
                  rdfs:domain :StopTime ;
                  rdfs:range :LocationGroup .


###  https://transit.ac.uk/ontologies/gtfs#hasParentStation
:hasParentStation rdf:type owl:ObjectProperty ;
                  rdfs:domain :Stop ;
                  rdfs:range :Stop .


###  https://transit.ac.uk/ontologies/gtfs#hasRoute
:hasRoute rdf:type owl:ObjectProperty ;
          rdfs:domain :Trip ;
          rdfs:range :Route .


###  https://transit.ac.uk/ontologies/gtfs#hasService
:hasService rdf:type owl:ObjectProperty ;
            rdfs:domain :Trip ;
