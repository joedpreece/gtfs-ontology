###  https://transit.ac.uk/ontologies/gtfs#StopOrPlatform
:StopOrPlatform rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Stop
                                                           [ rdf:type owl:Class ;
                                                             owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                             owl:onProperty :location_type ;
                                                                             owl:hasValue 0
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty :location_type ;
                                                                             owl:cardinality "0"^^xsd:nonNegativeInteger
                                                                           ]
                                                                         )
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :Stop ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :stop_lat ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :stop_lon ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :stop_name ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] .


