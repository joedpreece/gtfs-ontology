        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#direction_id -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#direction_id">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#Trip"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#drop_off_type -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#drop_off_type">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#StopTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#end_date -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#end_date">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#end_pickup_drop_off_window -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#end_pickup_drop_off_window">
