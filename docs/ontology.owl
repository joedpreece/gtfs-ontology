        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#exception_type -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#exception_type">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#friday -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#friday">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#location_type -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#location_type">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#Stop"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#monday -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#monday">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#network_id -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#network_id">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#Route"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#pickup_type -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#pickup_type">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#StopTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#platform_code -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#platform_code">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#Stop"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#route_color -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#route_color">
