        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#route_long_name -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#route_long_name">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#Route"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://transit.ac.uk/ontologies/gtfs#route_short_name -->


    <owl:DatatypeProperty rdf:about="https://transit.ac.uk/ontologies/gtfs#route_short_name">
        <rdfs:domain rdf:resource="https://transit.ac.uk/ontologies/gtfs#Route"/>
