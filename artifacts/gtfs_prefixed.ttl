    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Etc/GMT+12"^^xsd:string "Etc/GMT+11"^^xsd:string "Pacific/Niue"^^xsd:string "Pacific/Pago_Pago"^^xsd:string "US/Samoa"^^xsd:string "Pacific/Samoa"^^xsd:string "Pacific/Midway"^^xsd:string "Etc/GMT+10"^^xsd:string "Pacific/Honolulu"^^xsd:string "US/Hawaii"^^xsd:string "Pacific/Johnston"^^xsd:string "HST"^^xsd:string "Pacific/Rarotonga"^^xsd:string "Pacific/Tahiti"^^xsd:string "America/Adak"^^xsd:string "US/Aleutian"^^xsd:string "America/Atka"^^xsd:string "Pacific/Marquesas"^^xsd:string "Etc/GMT+9"^^xsd:string "Pacific/Gambier"^^xsd:string "America/Anchorage"^^xsd:string "US/Alaska"^^xsd:string "America/Juneau"^^xsd:string "America/Metlakatla"^^xsd:string "America/Nome"^^xsd:string "America/Sitka"^^xsd:string "America/Yakutat"^^xsd:string "Etc/GMT+8"^^xsd:string "Pacific/Pitcairn"^^xsd:string "America/Los_Angeles"^^xsd:string "US/Pacific"^^xsd:string "PST8PDT"^^xsd:string "America/Tijuana"^^xsd:string "Mexico/BajaNorte"^^xsd:string "America/Ensenada"^^xsd:string "America/Santa_Isabel"^^xsd:string "America/Vancouver"^^xsd:string "Canada/Pacific"^^xsd:string "Etc/GMT+7"^^xsd:string "America/Dawson_Creek"^^xsd:string "America/Dawson"^^xsd:string "America/Fort_Nelson"^^xsd:string "America/Hermosillo"^^xsd:string "America/Mazatlan"^^xsd:string "Mexico/BajaSur"^^xsd:string "America/Phoenix"^^xsd:string "MST"^^xsd:string "US/Arizona"^^xsd:string "America/Creston"^^xsd:string "America/Whitehorse"^^xsd:string "Canada/Yukon"^^xsd:string "America/Boise"^^xsd:string "America/Cambridge_Bay"^^xsd:string "America/Ciudad_Juarez"^^xsd:string "America/Denver"^^xsd:string "MST7MDT"^^xsd:string "Navajo"^^xsd:string "US/Mountain"^^xsd:string "America/Shiprock"^^xsd:string "America/Edmonton"^^xsd:string "Canada/Mountain"^^xsd:string "America/Yellowknife"^^xsd:string "America/Inuvik"^^xsd:string "Etc/GMT+6"^^xsd:string "America/Bahia_Banderas"^^xsd:string "America/Belize"^^xsd:string "America/Chihuahua"^^xsd:string "America/Costa_Rica"^^xsd:string "America/El_Salvador"^^xsd:string "Pacific/Galapagos"^^xsd:string "America/Guatemala"^^xsd:string "America/Managua"^^xsd:string "America/Merida"^^xsd:string "America/Mexico_City"^^xsd:string "Mexico/General"^^xsd:string "America/Monterrey"^^xsd:string "America/Regina"^^xsd:string "Canada/Saskatchewan"^^xsd:string "America/Swift_Current"^^xsd:string "America/Tegucigalpa"^^xsd:string "America/North_Dakota/Beulah"^^xsd:string "America/North_Dakota/Center"^^xsd:string "America/Chicago"^^xsd:string "CST6CDT"^^xsd:string "US/Central"^^xsd:string "Pacific/Easter"^^xsd:string "Chile/EasterIsland"^^xsd:string "America/Indiana/Knox"^^xsd:string "US/Indiana-Starke"^^xsd:string "America/Knox_IN"^^xsd:string "America/Matamoros"^^xsd:string "America/Menominee"^^xsd:string "America/North_Dakota/New_Salem"^^xsd:string "America/Ojinaga"^^xsd:string "America/Rankin_Inlet"^^xsd:string "America/Resolute"^^xsd:string "America/Indiana/Tell_City"^^xsd:string "America/Winnipeg"^^xsd:string "Canada/Central"^^xsd:string "America/Rainy_River"^^xsd:string "Etc/GMT+5"^^xsd:string "America/Bogota"^^xsd:string "America/Cancun"^^xsd:string "America/Eirunepe"^^xsd:string "America/Guayaquil"^^xsd:string "America/Jamaica"^^xsd:string "Jamaica"^^xsd:string "America/Lima"^^xsd:string "America/Panama"^^xsd:string "EST"^^xsd:string "America/Atikokan"^^xsd:string "America/Cayman"^^xsd:string "America/Coral_Harbour"^^xsd:string "America/Rio_Branco"^^xsd:string "Brazil/Acre"^^xsd:string "America/Porto_Acre"^^xsd:string "America/Detroit"^^xsd:string "US/Michigan"^^xsd:string "America/Grand_Turk"^^xsd:string "America/Havana"^^xsd:string "Cuba"^^xsd:string "America/Indiana/Indianapolis"^^xsd:string "US/East-Indiana"^^xsd:string "America/Indianapolis"^^xsd:string "America/Fort_Wayne"^^xsd:string "America/Iqaluit"^^xsd:string "America/Pangnirtung"^^xsd:string "America/Kentucky/Louisville"^^xsd:string "America/Louisville"^^xsd:string "America/Indiana/Marengo"^^xsd:string "America/Kentucky/Monticello"^^xsd:string "America/New_York"^^xsd:string "EST5EDT"^^xsd:string "US/Eastern"^^xsd:string "America/Indiana/Petersburg"^^xsd:string "America/Port-au-Prince"^^xsd:string "America/Toronto"^^xsd:string "Canada/Eastern"^^xsd:string "America/Nassau"^^xsd:string "America/Montreal"^^xsd:string "America/Nipigon"^^xsd:string "America/Thunder_Bay"^^xsd:string "America/Indiana/Vevay"^^xsd:string "America/Indiana/Vincennes"^^xsd:string "America/Indiana/Winamac"^^xsd:string "Etc/GMT+4"^^xsd:string "America/Barbados"^^xsd:string "America/Boa_Vista"^^xsd:string "America/Campo_Grande"^^xsd:string "America/Caracas"^^xsd:string "America/Cuiaba"^^xsd:string "America/Guyana"^^xsd:string "America/La_Paz"^^xsd:string "America/Manaus"^^xsd:string "Brazil/West"^^xsd:string "America/Martinique"^^xsd:string "America/Porto_Velho"^^xsd:string "America/Puerto_Rico"^^xsd:string "America/Virgin"^^xsd:string "America/Anguilla"^^xsd:string "America/Antigua"^^xsd:string "America/Aruba"^^xsd:string "America/Blanc-Sablon"^^xsd:string "America/Curacao"^^xsd:string "America/Dominica"^^xsd:string "America/Grenada"^^xsd:string "America/Guadeloupe"^^xsd:string "America/Kralendijk"^^xsd:string "America/Lower_Princes"^^xsd:string "America/Marigot"^^xsd:string "America/Montserrat"^^xsd:string "America/Port_of_Spain"^^xsd:string "America/St_Barthelemy"^^xsd:string "America/St_Kitts"^^xsd:string "America/St_Lucia"^^xsd:string "America/St_Thomas"^^xsd:string "America/St_Vincent"^^xsd:string "America/Tortola"^^xsd:string "America/Santo_Domingo"^^xsd:string "Atlantic/Bermuda"^^xsd:string "America/Glace_Bay"^^xsd:string "America/Goose_Bay"^^xsd:string "America/Halifax"^^xsd:string "Canada/Atlantic"^^xsd:string "America/Moncton"^^xsd:string "America/Santiago"^^xsd:string "Chile/Continental"^^xsd:string "America/Thule"^^xsd:string "America/St_Johns"^^xsd:string "Canada/Newfoundland"^^xsd:string "Etc/GMT+3"^^xsd:string "America/Araguaina"^^xsd:string "America/Asuncion"^^xsd:string "America/Bahia"^^xsd:string "America/Belem"^^xsd:string "America/Argentina/Buenos_Aires"^^xsd:string "America/Buenos_Aires"^^xsd:string "America/Argentina/Catamarca"^^xsd:string "America/Catamarca"^^xsd:string "America/Argentina/ComodRivadavia"^^xsd:string "America/Cayenne"^^xsd:string "America/Argentina/Cordoba"^^xsd:string "America/Cordoba"^^xsd:string "America/Rosario"^^xsd:string "America/Coyhaique"^^xsd:string "America/Fortaleza"^^xsd:string "America/Argentina/Jujuy"^^xsd:string "America/Jujuy"^^xsd:string "America/Argentina/La_Rioja"^^xsd:string "America/Maceio"^^xsd:string "America/Argentina/Mendoza"^^xsd:string "America/Mendoza"^^xsd:string "America/Montevideo"^^xsd:string "Antarctica/Palmer"^^xsd:string "America/Paramaribo"^^xsd:string "America/Punta_Arenas"^^xsd:string "America/Recife"^^xsd:string "America/Argentina/Rio_Gallegos"^^xsd:string "Antarctica/Rothera"^^xsd:string "America/Argentina/Salta"^^xsd:string "America/Argentina/San_Juan"^^xsd:string "America/Argentina/San_Luis"^^xsd:string "America/Santarem"^^xsd:string "America/Sao_Paulo"^^xsd:string "Brazil/East"^^xsd:string "Atlantic/Stanley"^^xsd:string "America/Argentina/Tucuman"^^xsd:string "America/Argentina/Ushuaia"^^xsd:string "America/Miquelon"^^xsd:string "Etc/GMT+2"^^xsd:string "America/Noronha"^^xsd:string "Brazil/DeNoronha"^^xsd:string "Atlantic/South_Georgia"^^xsd:string "America/Nuuk"^^xsd:string "America/Godthab"^^xsd:string "America/Scoresbysund"^^xsd:string "Etc/GMT+1"^^xsd:string "Atlantic/Cape_Verde"^^xsd:string "Atlantic/Azores"^^xsd:string "Factory"^^xsd:string "Etc/GMT"^^xsd:string "GMT"^^xsd:string "Etc/GMT+0"^^xsd:string "Etc/GMT-0"^^xsd:string "Etc/GMT0"^^xsd:string "Etc/Greenwich"^^xsd:string "GMT+0"^^xsd:string "GMT-0"^^xsd:string "GMT0"^^xsd:string "Greenwich"^^xsd:string "Etc/UTC"^^xsd:string "Etc/UCT"^^xsd:string "Etc/Universal"^^xsd:string "Etc/Zulu"^^xsd:string "UCT"^^xsd:string "UTC"^^xsd:string "Universal"^^xsd:string "Zulu"^^xsd:string "Africa/Abidjan"^^xsd:string "Iceland"^^xsd:string "Africa/Accra"^^xsd:string "Africa/Bamako"^^xsd:string "Africa/Banjul"^^xsd:string "Africa/Conakry"^^xsd:string "Africa/Dakar"^^xsd:string "Africa/Freetown"^^xsd:string "Africa/Lome"^^xsd:string "Africa/Nouakchott"^^xsd:string "Africa/Ouagadougou"^^xsd:string "Atlantic/Reykjavik"^^xsd:string "Atlantic/St_Helena"^^xsd:string "Africa/Timbuktu"^^xsd:string "Africa/Bissau"^^xsd:string "America/Danmarkshavn"^^xsd:string "Africa/Monrovia"^^xsd:string "Africa/Sao_Tome"^^xsd:string "Atlantic/Canary"^^xsd:string "Europe/Dublin"^^xsd:string "Eire"^^xsd:string "Atlantic/Faroe"^^xsd:string "Atlantic/Faeroe"^^xsd:string "Europe/Lisbon"^^xsd:string "Portugal"^^xsd:string "WET"^^xsd:string "Europe/London"^^xsd:string "GB"^^xsd:string "GB-Eire"^^xsd:string "Europe/Guernsey"^^xsd:string "Europe/Isle_of_Man"^^xsd:string "Europe/Jersey"^^xsd:string "Europe/Belfast"^^xsd:string ) ] .

:trip_headsign a owl:DatatypeProperty ;
    rdfs:comment """
Text that appears on signage identifying the trip's destination to riders. This field is recommended for all services with headsign text displayed on the vehicle which may be used to distinguish amongst trips in a route.

If the headsign changes during a trip, values for trip_headsign may be overridden by defining values in stop_times.stop_headsign for specific stop_times along the trip.
"""@en ;
    rdfs:domain :Trip ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:trip_short_name a owl:DatatypeProperty ;
    rdfs:comment """
Public facing text used to identify the trip to riders, for instance, to identify train numbers for commuter rail trips. If riders do not commonly rely on trip names, trip_short_name should be empty. A trip_short_name value, if provided, should uniquely identify a trip within a service day; it should not be used for destination names or limited/express designations.
"""@en ;
    rdfs:domain :Trip ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:tts_stop_name a owl:DatatypeProperty ;
    rdfs:comment """
Readable version of the stop_name.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:tuesday a owl:DatatypeProperty ;
    rdfs:comment """
Functions in the same way as monday except applies to Tuesdays
"""@en ;
    rdfs:domain :Service ;
    rdfs:range :weekday_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendartxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:wednesday a owl:DatatypeProperty ;
    rdfs:comment """
Functions in the same way as monday except applies to Tuesdays
"""@en ;
    rdfs:domain :Service ;
    rdfs:range :weekday_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendartxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:wheelchair_accessible_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 ) ] .

:wheelchair_boarding_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 ) ] .

:zone_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies the fare zone for a stop. If this record represents a station or station entrance, the zone_id is ignored.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

gtfs_linked:Route a owl:Class ;
    rdfs:subClassOf owl:Thing .

<http://www.w3.org/2003/01/geo/wgs84_pos#latitude> a owl:DatatypeProperty .

<http://www.w3.org/2003/01/geo/wgs84_pos#longitude> a owl:DatatypeProperty .

dcat:Dataset a owl:Class ;
    rdfs:subClassOf owl:Thing .

:FeedSpecification a owl:Class ;
    rdfs:comment "A specification for a transit feed."@en ;
    rdfs:subClassOf owl:Thing .

:StopFile a owl:Class ;
    rdfs:comment """
Stops where vehicles pick up or drop off riders. Also defines stations and station entrances.

Conditionally Required:
- Optional if demand-responsive zones are defined in locations.geojson.
- Required otherwise.
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#dataset-files"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Stop ;
            owl:onProperty :hasRecord ],
        :DatasetFile .

:color a owl:DatatypeProperty ;
    rdfs:comment """
A color encoded as a six-digit hexadecimal number. Refer to https://htmlcolorcodes.com to generate a valid value (the leading "#" must not be included).
Example: FFFFFF for white, 000000 for black or 0039A6 for the A,C,E lines in NYMTA.
"""@en ;
    rdfs:range :color_pattern ;
    rdfs:seeAlso "https://htmlcolorcodes.com/"^^xsd:string ;
    rdfs:subPropertyOf :field .

:num_int a owl:DatatypeProperty ;
    rdfs:comment """
An integer.
"""@en ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf :field .

:route_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies a route.
"""@en ;
    rdfs:domain :Route,
        :Trip ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string,
        "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:shape_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies a geospatial shape describing the vehicle travel path for a trip.

Conditionally Required:
- Required if the trip has a continuous pickup or drop-off behavior defined either in routes.txt or in stop_times.txt.
- Optional otherwise.
"""@en ;
    rdfs:domain :Trip ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:timezone a owl:DatatypeProperty ;
    rdfs:comment """
TZ timezone from the https://www.iana.org/time-zones. Timezone names never contain the space character but may contain an underscore. Refer to http://en.wikipedia.org/wiki/List_of_tz_zones for a list of valid values.
Example: Asia/Tokyo, America/Los_Angeles or Africa/Cairo.
"""@en ;
    rdfs:range :timezone_enum ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/List_of_tz_zones"^^xsd:string,
        "https://www.iana.org/time-zones"^^xsd:string ;
    rdfs:subPropertyOf :field .

:trip_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies a trip.
"""@en ;
    rdfs:domain :StopTime,
        :Trip ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string,
        "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:AgencyFileWithMultipleAgencies a owl:Class ;
    rdfs:comment """
An agency file with multiple agencies.
"""@en ;
    rdfs:subClassOf :AgencyFile ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass :Agency ;
            owl:onProperty :hasRecord ] .

:CalendarDateFile a owl:Class ;
    rdfs:comment """
Exceptions for the services defined in the calendar.txt.

Conditionally Required:
- Required if calendar.txt is omitted. In which case calendar_dates.txt must contain all dates of service.
- Optional otherwise.
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#dataset-files"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Service ;
            owl:onProperty :hasRecord ],
        :DatasetFile .

:TripFile a owl:Class ;
    rdfs:comment """
Trips for each route. A trip is a sequence of two or more stops that occur during a specific time period.
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#dataset-files"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Trip ;
            owl:onProperty :hasRecord ],
        :DatasetFile .

:date a owl:DatatypeProperty ;
    rdfs:comment """
Service day in the YYYYMMDD format. Since time within a service day may be above 24:00:00, a service day may contain information for the subsequent day(s).
Example: 20180913 for September 13th, 2018.
"""@en ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf :field .

:direction_id a owl:DatatypeProperty ;
    rdfs:comment """
Indicates the direction of travel for a trip. This field should not be used in routing; it provides a way to separate trips by direction when publishing time tables. Valid options are:

0 - Travel in one direction (e.g. outbound travel).
1 - Travel in the opposite direction (e.g. inbound travel).
"""@en ;
    rdfs:domain :Trip ;
    rdfs:range :direction_id_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:parent_station a owl:DatatypeProperty ;
    rdfs:comment """
Defines hierarchy between the different locations defined in stops.txt. It contains the ID of the parent location, as followed:

- Stop/platform (location_type=0): the parent_station field contains the ID of a station.
- Station (location_type=1): this field must be empty.
- Entrance/exit (location_type=2) or generic node (location_type=3): the parent_station field contains the ID of a station (location_type=1)
- Boarding Area (location_type=4): the parent_station field contains ID of a platform.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:route_long_name a owl:DatatypeProperty ;
    rdfs:comment """
Full name of a route. This name is generally more descriptive than the route_short_name and often includes the route's destination or stop. Both route_short_name and route_long_name may be defined.
"""@en ;
    rdfs:domain :Route ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:route_short_name a owl:DatatypeProperty ;
    rdfs:comment """
Short name of a route. Often a short, abstract identifier (e.g., "32", "100X", "Green") that riders use to identify a route. Both route_short_name and route_long_name may be defined.
"""@en ;
    rdfs:domain :Route ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:service_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies a set of dates when a service exception occurs for one or more routes. Each (service_id, date) pair may only appear once in calendar_dates.txt if using calendar.txt and calendar_dates.txt in conjunction. If a service_id value appears in both calendar.txt and calendar_dates.txt, the information in calendar_dates.txt modifies the service information specified in calendar.txt.
"""@en,
        """
Identifies a set of dates when service is available for one or more routes.
"""@en ;
    rdfs:domain :Service,
        :Trip ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendar_datestxt"^^xsd:string,
        "https://gtfs.org/documentation/schedule/reference/#calendartxt"^^xsd:string,
        "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:stop_access a owl:DatatypeProperty ;
    rdfs:comment """
Indicates how the stop is accessed for a particular station. Valid options are:

0 - The stop/platform cannot be directly accessed from the street network. It must be accessed from a station entrance if there is one defined for the station, otherwise the station itself. If there are pathways defined for the station, they must be used to access the stop/platform.
1 - Consuming applications should generate directions for access directly to the stop, independent of any entrances or pathways of the parent station.

When stop_access is empty, the access for the specified stop or platform is considered undefined.

Conditionally Forbidden:
- Forbidden for locations which are stations (location_type=1), entrances (location_type=2), generic nodes (location_type=3) or boarding areas (location_type=4).
- Forbidden if parent_station is empty.
- Optional otherwise.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:range :stop_access_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:timepoint a owl:DatatypeProperty ;
    rdfs:comment """
Indicates if arrival and departure times for a stop are strictly adhered to by the vehicle or if they are instead approximate and/or interpolated times. This field allows a GTFS producer to provide interpolated stop-times, while indicating that the times are approximate.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:range :timepoint_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

gtfs_linked:StopTime a owl:Class ;
    rdfs:subClassOf owl:Thing .

:AgencyFile a owl:Class ;
    rdfs:comment """
Transit agencies with service represented in this dataset.
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#dataset-files"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Agency ;
            owl:onProperty :hasRecord ],
        :DatasetFile .

:CalendarFile a owl:Class ;
    rdfs:comment """
Service dates specified using a weekly schedule with start and end dates.

Conditionally Required:
- Required unless all dates of service are defined in calendar_dates.txt.
- Optional otherwise.
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#dataset-files"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Service ;
            owl:onProperty :hasRecord ],
        :DatasetFile .

:agency_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies a transit brand which is often synonymous with a transit agency. In some cases, a single agency operates multiple separate services and agencies and brands are distinct. This document uses the term “agency” in place of “brand”. A dataset may contain data from multiple agencies.
"""@en,
        """
When used on Route: Agency for the specified route.
"""@en ;
    rdfs:domain :Agency,
        :Route ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#agencytxt"^^xsd:string,
        "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:isFileOf a owl:ObjectProperty .

:stop_lat a owl:DatatypeProperty ;
    rdfs:comment """
Latitude of the location.

For stops/platforms (location_type=0) and boarding area (location_type=4), the coordinates must be the ones of the bus pole — if exists — and otherwise of where the travelers are boarding the vehicle (on the sidewalk or the platform, and not on the roadway or the track where the vehicle stops). 
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf <http://www.w3.org/2003/01/geo/wgs84_pos#latitude> .

:stop_lon a owl:DatatypeProperty ;
    rdfs:comment """
Longitude of the location.

For stops/platforms (location_type=0) and boarding area (location_type=4), the coordinates must be the ones of the bus pole — if exists — and otherwise of where the travelers are boarding the vehicle (on the sidewalk or the platform, and not on the roadway or the track where the vehicle stops).
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf <http://www.w3.org/2003/01/geo/wgs84_pos#longitude> .

:stop_name a owl:DatatypeProperty ;
    rdfs:comment """
Indicates how the stop is accessed for a particular station. Valid options are:

0 - The stop/platform cannot be directly accessed from the street network. It must be accessed from a station entrance if there is one defined for the station, otherwise the station itself. If there are pathways defined for the station, they must be used to access the stop/platform.
1 - Consuming applications should generate directions for access directly to the stop, independent of any entrances or pathways of the parent station.

When stop_access is empty, the access for the specified stop or platform is considered undefined.

Conditionally Forbidden:
- Forbidden for locations which are stations (location_type=1), entrances (location_type=2), generic nodes (location_type=3) or boarding areas (location_type=4).
- Forbidden if parent_station is empty.
- Optional otherwise.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:time a owl:DatatypeProperty ;
    rdfs:comment """
Time in the HH:MM:SS format (H:MM:SS is also accepted). The time is measured from "noon minus 12h" of the service day (effectively midnight except for days on which daylight savings time changes occur). For times occurring after midnight on the service day, enter the time as a value greater than 24:00:00 in HH:MM:SS.
Example: 14:30:00 for 2:30PM or 25:35:00 for 1:35AM on the next day.
"""@en ;
    rdfs:range xsd:time ;
    rdfs:subPropertyOf :field .

:url a owl:DatatypeProperty ;
    rdfs:comment """
TZ timezone from the https://www.iana.org/time-zones. Timezone names never contain the space character but may contain an underscore. Refer to http://en.wikipedia.org/wiki/List_of_tz_zones for a list of valid values.
Example: Asia/Tokyo, America/Los_Angeles or Africa/Cairo.
"""@en ;
    rdfs:range schema:url ;
    rdfs:seeAlso "http://www.w3.org/Addressing/URL/4_URI_Recommentations.html"^^xsd:string ;
    rdfs:subPropertyOf :field .

:bikes_allowed a owl:DatatypeProperty ;
    rdfs:comment """
Indicates whether bikes are allowed. Valid options are:

0 or empty - No bike information for the trip.
1 - Vehicle being used on this particular trip can accommodate at least one bicycle.
2 - No bicycles are allowed on this trip.
"""@en ;
    rdfs:domain :Trip ;
    rdfs:range :bikes_allowed_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:cars_allowed a owl:DatatypeProperty ;
    rdfs:comment """
Indicates whether cars are allowed. Valid options are:

0 or empty - No car information for the trip.
1 - Vehicle being used on this particular trip can accommodate at least one car.
2 - No cars are allowed on this trip.
"""@en ;
    rdfs:domain :Trip ;
    rdfs:range :cars_allowed_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:cemv_support a owl:DatatypeProperty ;
    rdfs:comment """
Indicates if riders can access a transit service (i.e., trip) associated with this agency by using a contactless EMV (Europay, Mastercard, and Visa) card or mobile device as fare media at a fare validator (such as in pay-as-you-go or open-loop systems). This field does not indicate that cEMV can be used to purchase other fare products or to add value to another fare media.

Support for cEMVs should only be indicated if all services under this agency are accessible with the use of cEMV cards or mobile devices as fare media.

Valid options are:

0 or empty - No cEMV information for trips associated with this agency.
1 - Riders may use cEMVs as fare media for trips associated with this agency.
2 - cEMVs are not supported as fare media for trips associated with this agency.

If both agency.cemv_support and routes.cemv_support are provided for the same service, the value in routes.cemv_support shall take precedence.

This field is independent of all other fare-related files and may be used separately. If there is conflicting information between this field and any fare-related file (such as fare_media.txt, fare_products.txt, or fare_leg_rules.txt), the information in those files shall take precedence over agency.cemv_support.
"""@en,
        """
When used on Route:

Indicates if riders can access a transit service (i.e., trip) associated with this route by using a contactless EMV (Europay, Mastercard, and Visa) card or mobile device as fare media at a fare validator (such as in pay-as-you-go or open-loop systems). This field does not indicate that cEMV can be used to purchase other fare products or to add value to another fare media.

Support for cEMVs should only be indicated if all services under this route are accessible with the use of cEMV cards or mobile devices as fare media.

Valid options are:

0 or empty - No cEMV information for trips associated with this route.
1 - Riders may use cEMVs as fare media for trips associated with this route.
2 - cEMVs are not supported as fare media for trips associated with this route.

If both agency.cemv_support and routes.cemv_support are provided for the same service, the value in routes.cemv_support shall take precedence.

This field is independent of all other fare-related files and may be used separately. If there is conflicting information between this field and any fare-related file (such as fare_media.txt, fare_products.txt, or fare_leg_rules.txt), the information in those files shall take precedence over agency.cemv_support.
"""@en ;
    rdfs:domain :Agency,
        :Route ;
    rdfs:range :cemv_support_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#agencytxt"^^xsd:string,
        "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:departure_time a owl:DatatypeProperty ;
    rdfs:comment """
Departure time from the stop (defined by stop_times.stop_id) for a specific trip (defined by stop_times.trip_id) in the time zone specified by agency.agency_timezone, not stops.stop_timezone.

If there are not separate times for arrival and departure at a stop, arrival_time and departure_time should be the same.

For times occurring after midnight on the service day, enter the time as a value greater than 24:00:00 in HH:MM:SS.

If exact arrival and departure times (timepoint=1) are not available, estimated or interpolated arrival and departure times (timepoint=0) should be provided.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :time .

:isRecordOf a owl:ObjectProperty .

:wheelchair_accessible a owl:DatatypeProperty ;
    rdfs:comment """
Indicates wheelchair accessibility. Valid options are:

0 or empty - No accessibility information for the trip.
1 - Vehicle being used on this particular trip can accommodate at least one rider in a wheelchair.
2 - No riders in wheelchairs can be accommodated on this trip.
"""@en ;
    rdfs:domain :Trip ;
    rdfs:range :wheelchair_accessible_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:Dataset a owl:Class ;
    rdfs:comment """
A complete set of files defined by this specification reference. Altering the dataset creates a new version of the dataset. Datasets should be published at a public, permanent URL, including the zip file name. (e.g., https://www.agency.org/gtfs/gtfs.zip).
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#term-definitions"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :StopTimeFile ;
            owl:onProperty :hasFile ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onClass :AgencyFile ;
                        owl:onProperty :hasFile ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass :StopFile ;
                        owl:onProperty :hasFile ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass :RouteFile ;
                        owl:onProperty :hasFile ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass :TripFile ;
                        owl:onProperty :hasFile ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass :StopTimeFile ;
                        owl:onProperty :hasFile ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :CalendarDateFile ;
                        owl:onProperty :hasFile ] [ a owl:Restriction ;
                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :CalendarFile ;
                        owl:onProperty :hasFile ] ) ],
        dcat:Dataset .

:RouteFile a owl:Class ;
    rdfs:comment """
Transit routes. A route is a group of trips that are displayed to riders as a single service.
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#dataset-files"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Route ;
            owl:onProperty :hasRecord ],
        :DatasetFile .

:StopOrPlatform a owl:Class ;
    rdfs:comment """
A location where passengers board or disembark from a transit vehicle.
"""@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_name ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_lat ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_lon ] ) ],
        :Stop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Stop [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:hasValue 0 ;
                                    owl:onProperty :location_type ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :location_type ] ) ] ) ] .

:StopTimeFile a owl:Class ;
    rdfs:comment """
Times that a vehicle arrives at and departs from stops for each trip.
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#dataset-files"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :StopTime ;
            owl:onProperty :hasRecord ],
        :DatasetFile .

:drop_off_type a owl:DatatypeProperty ;
    rdfs:comment """
Indicates drop off method.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:range :drop_off_type_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:pickup_type a owl:DatatypeProperty ;
    rdfs:comment """
Indicates pickup method.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:range :pickup_type_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:stop_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies a location: stop/platform, station, entrance/exit, generic node or boarding area (see location_type).

ID must be unique across all stops.stop_id, locations.geojson id, and location_groups.location_group_id values.

Multiple routes may use the same stop_id.
"""@en,
        """
Identifies the serviced stop. All stops serviced during a trip must have a record in stop_times.txt. Referenced locations must be stops/platforms, i.e. their stops.location_type value must be 0 or empty. A stop may be serviced multiple times in the same trip, and multiple trips and routes may service the same stop.

On-demand service using stops should be referenced in the sequence in which service is available at those stops. A data consumer should assume that travel is possible from one stop or location to any stop or location later in the trip, provided that the pickup/drop_off_type of each stop_time and the time constraints of each start/end_pickup_drop_off_window do not forbid it.

Conditionally Required:
- Required if stop_times.location_group_id AND stop_times.location_id are NOT defined.
- Forbidden if stop_times.location_group_id or stop_times.location_id are defined.
"""@en ;
    rdfs:domain :Stop,
        :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string,
        "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:EntranceOrExit a owl:Class ;
    rdfs:comment """
A location where passengers can enter or exit a station from the street. If an entrance/exit belongs to multiple stations, it may be linked by pathways to both, but the data provider must pick one of them as parent.
"""@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_name ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_lat ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_lon ] ) ],
        :ChildStop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Stop [ a owl:Restriction ;
                        owl:hasValue 2 ;
                        owl:onProperty :location_type ] ) ] .

:arrival_time a owl:DatatypeProperty ;
    rdfs:comment """
Arrival time at the stop (defined by stop_times.stop_id) for a specific trip (defined by stop_times.trip_id) in the time zone specified by agency.agency_timezone, not stops.stop_timezone. 
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :time .

:location_group_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies the serviced location group that indicates groups of stops where riders may request pickup or drop off. All location groups serviced during a trip must have a record in stop_times.txt. Multiple trips and routes may service the same location group.

On-demand service using location groups should be referenced in the sequence in which service is available at those location groups. A data consumer should assume that travel is possible from one stop or location to any stop or location later in the trip, provided that the pickup/drop_off_type of each stop_time and the time constraints of each start/end_pickup_drop_off_window do not forbid it.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:location_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies the GeoJSON location that corresponds to serviced zone where riders may request pickup or drop off. All GeoJSON locations serviced during a trip must have a record in stop_times.txt. Multiple trips and routes may service the same GeoJSON location.

On-demand service within locations should be referenced in the sequence in which service is available in those locations. A data consumer should assume that travel is possible from one stop or location to any stop or location later in the trip, provided that the pickup/drop_off_type of each stop_time and the time constraints of each start/end_pickup_drop_off_window do not forbid it.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:location_type a owl:DatatypeProperty ;
    rdfs:comment """
Location type. Valid options are:

0 (or empty) - Stop (or Platform). A location where passengers board or disembark from a transit vehicle. Is called a platform when defined within a parent_station.
1 - Station. A physical structure or area that contains one or more platform.
2 - Entrance/Exit. A location where passengers can enter or exit a station from the street. If an entrance/exit belongs to multiple stations, it may be linked by pathways to both, but the data provider must pick one of them as parent.
3 - Generic Node. A location within a station, not matching any other location_type, that may be used to link together pathways define in pathways.txt.
4 - Boarding Area. A specific location on a platform, where passengers can board and/or alight vehicles.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:range :location_type_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:weekday_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 ) ] .

:ParentlessStop a owl:Class ;
    rdfs:comment """
A parentless stop is a stop that does not reference a parent station.
It represents a standalone boarding or alighting location that is not a child of another stop.
"""@en ;
    rdfs:subClassOf :Stop ;
    owl:disjointWith :ChildStop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Stop [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :parent_station ] ) ] .

:Record a owl:Class ;
    rdfs:comment """
A basic data structure comprised of a number of different field values describing a single entity (e.g. transit agency, stop, route, etc.). Represented, in a table, as a row.
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#term-definitions"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:DatasetFile a owl:Class ;
    rdfs:comment """
A file that is part of a dataset, that has records and fields.
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#dataset-files"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:continuous_drop_off a owl:DatatypeProperty ;
    rdfs:comment """
Indicates that the rider can alight from the transit vehicle at any point along the vehicle’s travel path as described by shapes.txt, from this stop_time to the next stop_time in the trip’s stop_sequence.
"""@en ;
    rdfs:domain :Route,
        :StopTime ;
    rdfs:range :continuous_drop_off_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:continuous_pickup a owl:DatatypeProperty ;
    rdfs:comment """
Indicates that the rider can board the transit vehicle at any point along the vehicle’s travel path as described by shapes.txt, from this stop_time to the next stop_time in the trip’s stop_sequence.
"""@en ;
    rdfs:domain :Route,
        :StopTime ;
    rdfs:range :continuous_pickup_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:route_type a owl:DatatypeProperty ;
    rdfs:comment """
Indicates the type of transportation used on a route. Valid options are:

0 - Tram, Streetcar, Light rail. Any light rail or street level system within a metropolitan area.
1 - Subway, Metro. Any underground rail system within a metropolitan area.
2 - Rail. Used for intercity or long-distance travel.
3 - Bus. Used for short- and long-distance bus routes.
4 - Ferry. Used for short- and long-distance boat service.
5 - Cable tram. Used for street-level rail cars where the cable runs beneath the vehicle (e.g., cable car in San Francisco).
6 - Aerial lift, suspended cable car (e.g., gondola lift, aerial tramway). Cable transport where cabins, cars, gondolas or open chairs are suspended by means of one or more cables.
7 - Funicular. Any rail system designed for steep inclines.
11 - Trolleybus. Electric buses that draw power from overhead wires using poles.
12 - Monorail. Railway in which the track consists of a single rail or a beam.
"""@en ;
    rdfs:domain :Route ;
    rdfs:range :route_type_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subPropertyOf :enum ;
    skos:relatedMatch gtfs_linked:RouteType .

:RecordWithAccessibilityInformation a owl:Class ;
    rdfs:comment """
Indicates whether wheelchair boardings are possible from the location. 
"""@en ;
    rdfs:subClassOf :Record .

:text a owl:DatatypeProperty ;
    rdfs:comment """
A string of UTF-8 characters, which is aimed to be displayed and which must therefore be human readable.
"""@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :field .

:ChildStop a owl:Class ;
    rdfs:comment """
A child stop is a sub-location of a station rather than a standalone stop or station.
"""@en ;
    rdfs:subClassOf :Stop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Stop [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :parent_station ] ) ] .

:hasRecord a owl:ObjectProperty ;
    rdfs:domain :DatasetFile ;
    rdfs:range :Record .

:wheelchair_boarding a owl:DatatypeProperty ;
    rdfs:comment """
Indicates whether wheelchair boardings are possible from the location. Valid options are:

For parentless stops:
0 or empty - No accessibility information for the stop.
1 - Some vehicles at this stop can be boarded by a rider in a wheelchair.
2 - Wheelchair boarding is not possible at this stop.

For child stops:
0 or empty - Stop will inherit its wheelchair_boarding behavior from the parent station, if specified in the parent.
1 - There exists some accessible path from outside the station to the specific stop/platform.
2 - There exists no accessible path from outside the station to the specific stop/platform.

For station entrances/exits:
0 or empty - Station entrance will inherit its wheelchair_boarding behavior from the parent station, if specified for the parent.
1 - Station entrance is wheelchair accessible.
2 - No accessible path from station entrance to stops/platforms.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:range :wheelchair_boarding_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:Agency a owl:Class ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#agencytxt"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :agency_id ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :agency_name ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :agency_url ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :agency_timezone ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :agency_lang ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :agency_phone ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :agency_fare_url ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :agency_email ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :cemv_support ] ) ],
        foaf:Agent,
        :Record ;
    skos:closeMatch gtfs_linked:Agency .

:hasFile a owl:ObjectProperty ;
    rdfs:domain :Dataset ;
    rdfs:range :DatasetFile .

:id a owl:DatatypeProperty ;
    rdfs:comment """
An ID field value is an internal ID, not intended to be shown to riders, and is a sequence of any UTF-8 characters. Using only printable ASCII characters is recommended. An ID is labeled "unique ID" when it must be unique within a file. IDs defined in one .txt file are often referenced in another .txt file. IDs that reference an ID in another table are labeled "foreign ID".
Example: The stop_id field in stops.txt is a "unique ID". The parent_station field in stops.txt is a "foreign ID referencing stops.stop_id".
"""@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :field .

:end_pickup_drop_off_window a owl:DatatypeProperty ;
    rdfs:comment """
Time that on-demand service ends in a GeoJSON location, location group, or stop.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :time .

:Service a owl:Class ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendar_datestxt"^^xsd:string,
        "https://gtfs.org/documentation/schedule/reference/#calendartxt"^^xsd:string ;
    rdfs:subClassOf :Record ;
    skos:closeMatch gtfs_linked:Service .

:start_pickup_drop_off_window a owl:DatatypeProperty ;
    rdfs:comment """
Time that on-demand service becomes available in a GeoJSON location, location group, or stop.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :time .

:field a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment """
A property of an object or entity. Represented, in a table, as a column. The field exists if added in a file as a header. It may or may not have field values defined.
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#term-definitions"^^xsd:string .

:enum a owl:DatatypeProperty ;
    rdfs:comment """
An option from a set of predefined constants defined in the "Description" column.
Example: The route_type field contains a 0 for tram, a 1 for subway...
"""@en ;
    rdfs:subPropertyOf :field .

:Trip a owl:Class ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :route_id ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :service_id ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :trip_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :trip_headsign ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :trip_short_name ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :direction_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :block_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :shape_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :wheelchair_accessible ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :bikes_allowed ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :cars_allowed ] ) ],
        :Record ;
    skos:closeMatch gtfs_linked:Trip .

:Stop a owl:Class ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_code ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_name ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :tts_stop_name ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_desc ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_lat ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_lon ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :zone_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_url ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :location_type ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :parent_station ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_timezone ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :wheelchair_boarding ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :level_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :platform_code ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_access ] ) ],
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>,
        :Record ;
    skos:closeMatch gtfs_linked:Stop .

:Route a owl:Class ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :route_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :agency_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :route_short_name ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :route_long_name ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :route_desc ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :route_type ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :route_url ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :route_color ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :route_text_color ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :route_sort_order ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :continuous_pickup ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :continuous_drop_off ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :network_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :cemv_support ] ) ],
        :Record ;
    skos:closeMatch gtfs_linked:Route .

:StopTime a owl:Class ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stop_timestxt"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :trip_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :arrival_time ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :departure_time ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :location_group_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :location_id ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_sequence ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_headsign ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :end_pickup_drop_off_window ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :pickup_type ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :drop_off_type ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :continuous_pickup ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :continuous_drop_off ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :shape_dist_traveled ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :timepoint ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :pickup_booking_rule_id ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :drop_off_booking_rule_id ] ) ],
        :Record ;
    skos:closeMatch gtfs_linked:StopTime .

[] a owl:AllDisjointClasses ;
    owl:members ( :StopLocation :Platform :Station :EntranceOrExit :GenericNode :BoardingArea ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :AgencyFile :StopFile :RouteFile :TripFile :StopTimeFile :CalendarFile :CalendarDateFile ) .

