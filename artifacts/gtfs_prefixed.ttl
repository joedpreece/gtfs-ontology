@prefix : <https://w3id.org/gtfs#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gtfs_linked: <http://vocab.gtfs.org/terms#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:creator a owl:AnnotationProperty .

gtfs_linked:Feed a owl:Class ;
    rdfs:subClassOf owl:Thing .

skos:closeMatch a owl:AnnotationProperty .

skos:relatedMatch a owl:AnnotationProperty .

schema:telephone a owl:DatatypeProperty .

<https://w3id.org/gtfs> a owl:Ontology ;
    rdfs:label "A GTFS Ontology"@en ;
    dcterms:creator "Joseph D. Preece"^^xsd:string ;
    rdfs:comment "An OWL ontology describing entities, relationships, and data structures found in the General Transit Feed Specification (GTFS)."@en ;
    owl:versionInfo "0.2.0"^^xsd:string .

:AerialLiftRoute a owl:Class ;
    rdfs:comment """
Cable transport where cabins, cars, gondolas or open chairs are suspended by means of one or more cables.
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 6 ;
            owl:onProperty :route_type ] .

:AgencyArrangedContinuousStoppingDropOff a owl:Class ;
    rdfs:comment "Must phone agency to arrange continuous stopping drop off."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue 2 ;
                        owl:onProperty :continuous_drop_off ] [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :end_pickup_drop_off_window ] ) ] ) ] .

:AgencyArrangedContinuousStoppingPickup a owl:Class ;
    rdfs:comment "Must phone agency to arrange continuous stopping pickup."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue 2 ;
                        owl:onProperty :continuous_pickup ] [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :end_pickup_drop_off_window ] ) ] ) ] .

:AgencyArrangedDropOff a owl:Class ;
    rdfs:comment "Must phone agency to arrange drop off."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 2 ;
            owl:onProperty :drop_off_type ] .

:AgencyArrangedPickup a owl:Class ;
    rdfs:comment "Must phone agency to arrange pickup."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 2 ;
            owl:onProperty :pickup_type ] .

:AgencyFileWithSingleAgency a owl:Class ;
    rdfs:comment """
An agency file with a single agency.
"""@en ;
    rdfs:subClassOf :AgencyFile ;
    owl:disjointWith :AgencyFileWithMultipleAgencies ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onClass :Agency ;
            owl:onProperty :hasRecord ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:AgencyWithinAgencyFileWithMultipleAgencies a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :agency_id ],
        :Agency ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Agency [ a owl:Restriction ;
                        owl:allValuesFrom :AgencyFileWithMultipleAgencies ;
                        owl:onProperty :isRecordOf ] ) ] .

:BusRoute a owl:Class ;
    rdfs:comment """
Used for short- and long-distance bus routes.
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 3 ;
            owl:onProperty :route_type ] .

:CableTramRoute a owl:Class ;
    rdfs:comment """
Used for street-level rail cars where the cable runs beneath the vehicle (e.g., cable car in San Francisco).
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 5 ;
            owl:onProperty :route_type ] .

:CalendarDateService a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :service_id ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :calendar_dates_date ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :exception_type ] ) ],
        :Service .

:CalendarService a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :service_id ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :monday ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :tuesday ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :wednesday ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :thursday ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :friday ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :saturday ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :sunday ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :start_date ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :end_date ] ) ],
        :Service .

:ContinuousStoppingDropOff a owl:Class ;
    rdfs:comment "Continuous stopping drop off."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue 0 ;
                        owl:onProperty :continuous_drop_off ] [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :end_pickup_drop_off_window ] ) ] ) ] .

:ContinuousStoppingPickup a owl:Class ;
    rdfs:comment "Continuous stopping pickup."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue 0 ;
                        owl:onProperty :continuous_pickup ] [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :end_pickup_drop_off_window ] ) ] ) ] .

:DatasetWithoutCalendarFile a owl:Class ;
    rdfs:comment "A dataset with a calendar file."@en ;
    rdfs:seeAlso :CalendarFile ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :CalendarDateFile ;
            owl:onProperty :hasFile ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :Dataset ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onClass :CalendarFile ;
            owl:onProperty :hasFile ;
            owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ] .

:DriverCoordinatedContinuousStoppingDropOff a owl:Class ;
    rdfs:comment "Must coordinate with driver to arrange continuous stopping drop off."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue 3 ;
                        owl:onProperty :continuous_drop_off ] [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :end_pickup_drop_off_window ] ) ] ) ] .

:DriverCoordinatedContinuousStoppingPickup a owl:Class ;
    rdfs:comment "Must coordinate with driver to arrange continuous stopping pickup. "@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue 3 ;
                        owl:onProperty :continuous_pickup ] [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :end_pickup_drop_off_window ] ) ] ) ] .

:DriverCoordinatedDropOff a owl:Class ;
    rdfs:comment "Must coordinate with driver to arrange drop off."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 3 ;
            owl:onProperty :drop_off_type ] .

:DriverCoordinatedPickup a owl:Class ;
    rdfs:comment "Driver coordinated pickup."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue 3 ;
                        owl:onProperty :pickup_type ] [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :end_pickup_drop_off_window ] ) ] ) ] .

:EntranceInheritingAccessibilityFromStation a owl:Class ;
    rdfs:comment """
Station entrance will inherit its wheelchair_boarding behavior from the parent station, if specified for the parent.
"""@en ;
    rdfs:subClassOf :EntranceOrExit,
        :RecordWithAccessibilityInformation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :EntranceOrExit [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:hasValue 0 ;
                                    owl:onProperty :wheelchair_boarding ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :wheelchair_boarding ] ) ] ) ] .

:EntranceWithNoAccessiblePathToPlatforms a owl:Class ;
    rdfs:comment """
No accessible path from station entrance to stops/platforms.
"""@en ;
    rdfs:subClassOf :EntranceOrExit,
        :RecordWithAccessibilityInformation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :EntranceOrExit [ a owl:Restriction ;
                        owl:hasValue 2 ;
                        owl:onProperty :wheelchair_boarding ] ) ] .

:FerryRoute a owl:Class ;
    rdfs:comment """
Used for short- and long-distance boat service.
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 4 ;
            owl:onProperty :route_type ] .

:FunicularRoute a owl:Class ;
    rdfs:comment """
Any rail system designed for steep inclines.
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 7 ;
            owl:onProperty :route_type ] .

:GTFSRealtime a owl:Class ;
    rdfs:comment """
GTFS Realtime is a feed specification that allows public transportation agencies to provide up-to-date information about current arrival and departure times, service alerts, and vehicle position, allowing users to smoothly plan their trips.

The specification currently supports the following types of information:

    Trip updates - delays, cancellations, changed routes
    Service alerts - stop moved, unforeseen events affecting a station, route or the entire network
    Vehicle positions - information about the vehicles including location and congestion level
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/overview/#gtfs-realtime"^^xsd:string ;
    rdfs:subClassOf :FeedSpecification .

:MonorailRoute a owl:Class ;
    rdfs:comment """
Railway in which the track consists of a single rail or a beam.
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 12 ;
            owl:onProperty :route_type ] .

:NoContinuousStoppingDropOff a owl:Class ;
    rdfs:comment "No continuous stopping drop off."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue 1 ;
                        owl:onProperty :continuous_drop_off ] [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :continuous_drop_off ] ) ] .

:NoContinuousStoppingPickup a owl:Class ;
    rdfs:comment "No continuous stopping pickup."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue 1 ;
                        owl:onProperty :continuous_pickup ] [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :continuous_pickup ] ) ] .

:NoDropOffAvailable a owl:Class ;
    rdfs:comment "No drop off available."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :drop_off_type ] .

:NoPickupAvailable a owl:Class ;
    rdfs:comment "No pickup available."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :pickup_type ] .

:RailRoute a owl:Class ;
    rdfs:comment """
Used for intercity or long-distance travel.
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 2 ;
            owl:onProperty :route_type ] .

:RegularlyScheduledDropOff a owl:Class ;
    rdfs:comment "Regularly scheduled drop off. "@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:hasValue 0 ;
                                    owl:onProperty :drop_off_type ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :drop_off_type ] ) ] [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :end_pickup_drop_off_window ] ) ] ) ] .

:RegularlyScheduledPickup a owl:Class ;
    rdfs:comment "Regularly scheduled pickup. "@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:hasValue 0 ;
                                    owl:onProperty :pickup_type ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :pickup_type ] ) ] [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :end_pickup_drop_off_window ] ) ] ) ] .

:RouteWithAgencyID a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :agency_id ],
        :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :RouteFile [ a owl:Restriction ;
                                owl:allValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( :Dataset [ a owl:Restriction ;
                                                    owl:onProperty :hasFile ;
                                                    owl:someValuesFrom :AgencyFileWithMultipleAgencies ] ) ] ;
                                owl:onProperty :isFileOf ] ) ] ;
            owl:onProperty :isRecordOf ] .

:RouteWithCEMVSupport a owl:Class ;
    rdfs:comment """
Riders may use cEMVs as fare media for trips associated with this route. 
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :cemv_support ] .

:RouteWithContinuousDropOff a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :continuous_drop_off ],
        :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :RouteFile [ a owl:Restriction ;
                                owl:allValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( :Dataset [ a owl:Restriction ;
                                                    owl:onProperty :hasFile ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( :StopTimeFile [ a owl:Restriction ;
                                                                        owl:onProperty :hasRecord ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( gtfs_linked:StopTime [ a owl:Class ;
                                                                                            owl:unionOf ( [ a owl:Restriction ;
                                                                                                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                        owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                                                                                                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                        owl:onProperty :end_pickup_drop_off_window ] ) ] ) ] ] ) ] ] ) ] ;
                                owl:onProperty :isRecordOf ] ) ] ;
            owl:onProperty :isFileOf ] .

:RouteWithContinuousPickup a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :continuous_pickup ],
        :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :RouteFile [ a owl:Restriction ;
                                owl:allValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( :Dataset [ a owl:Restriction ;
                                                    owl:onProperty :hasFile ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:intersectionOf ( :StopTimeFile [ a owl:Restriction ;
                                                                        owl:onProperty :hasRecord ;
                                                                        owl:someValuesFrom [ a owl:Class ;
                                                                                owl:intersectionOf ( gtfs_linked:StopTime [ a owl:Class ;
                                                                                            owl:unionOf ( [ a owl:Restriction ;
                                                                                                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                        owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                                                                                                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                        owl:onProperty :end_pickup_drop_off_window ] ) ] ) ] ] ) ] ] ) ] ;
                                owl:onProperty :isRecordOf ] ) ] ;
            owl:onProperty :isFileOf ] .

:RouteWithNoCEMVInformation a owl:Class ;
    rdfs:comment """
No cEMV information for trips associated with this route. 
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 0 ;
            owl:onProperty :cemv_support ] .

:RouteWithNoCEMVSupport a owl:Class ;
    rdfs:comment """
cEMVs are not supported as fare media for trips associated with this route. 
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 2 ;
            owl:onProperty :cemv_support ] .

:RouteWithNoLongName a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :route_short_name ],
        :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty :route_long_name ] .

:RouteWithNoShortName a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :route_long_name ],
        :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty :route_short_name ] .

:StopAccessibleViaStationOnly a owl:Class ;
    rdfs:comment """
The stop/platform cannot be directly accessed from the street network. It must be accessed from a station entrance if there is one defined for the station, otherwise the station itself. If there are pathways defined for the station, they must be used to access the stop/platform.
"""@en ;
    rdfs:subClassOf :ChildStop,
        :StopOrPlatform ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 0 ;
            owl:onProperty :stop_access ] .

:StopDirectlyAccessibleFromStreet a owl:Class ;
    rdfs:comment """
Consuming applications should generate directions for access directly to the stop, independent of any entrances or pathways of the parent station.
"""@en ;
    rdfs:subClassOf :ChildStop,
        :StopOrPlatform ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :stop_access ] .

:StopInheritingAccessibilityFromStation a owl:Class ;
    rdfs:comment """
Stop will inherit its wheelchair_boarding behavior from the parent station, if specified in the parent.
"""@en ;
    rdfs:subClassOf :ChildStop,
        :RecordWithAccessibilityInformation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ChildStop [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:hasValue 0 ;
                                    owl:onProperty :wheelchair_boarding ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :wheelchair_boarding ] ) ] ) ] .

:StopTimeApproximateTime a owl:Class ;
    rdfs:comment "Times are considered approximate."@en ;
    rdfs:subClassOf :StopTime ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 0 ;
            owl:onProperty :timepoint ] .

:StopTimeExactTime a owl:Class ;
    rdfs:comment "Times are considered exact."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :arrival_time ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :departure_time ] ) ],
        :StopTime ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :timepoint ] .

:StopTimeFirst a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :arrival_time ],
        :StopTime .

:StopTimeLast a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :arrival_time ],
        :StopTime .

:StopTimeWithEndPickupDropOffWindow a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :end_pickup_drop_off_window ],
        :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :location_id ] [ a owl:Restriction ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :location_group_id ] ) ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :start_pickup_drop_off_window ] ) ] .

:StopTimeWithNoEndPickupDropOffWindow a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty :start_pickup_drop_off_window ],
        :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :arrival_time ] [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :departure_time ] ) ] .

:StopTimeWithNoLocationGroupID a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty :location_group_id ],
        :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_id ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :location_id ] ) ] .

:StopTimeWithNoLocationID a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty :location_id ],
        :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_id ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :location_group_id ] ) ] .

:StopTimeWithNoStartPickupDropOffWindow a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty :start_pickup_drop_off_window ],
        :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :arrival_time ] [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :departure_time ] ) ] .

:StopTimeWithNoStopID a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty :stop_id ],
        :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :location_id ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :location_group_id ] ) ] .

:StopTimeWithPickupDropOffWindow a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :arrival_time ] [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :departure_time ] ) ],
        :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :start_pickup_drop_off_window ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :end_pickup_drop_off_window ] ) ] .

:StopTimeWithStartPickupDropOffWindow a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :start_pickup_drop_off_window ],
        :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :location_id ] [ a owl:Restriction ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :location_group_id ] ) ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :end_pickup_drop_off_window ] ) ] .

:StopTimeWithStopID a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :stop_id ],
        :StopTime ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :location_id ] [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :location_group_id ] ) ] .

:StopWithAccessiblePathFromOutsideStation a owl:Class ;
    rdfs:comment """
There exists some accessible path from outside the station to the specific stop/platform.
"""@en ;
    rdfs:subClassOf :ChildStop,
        :RecordWithAccessibilityInformation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ChildStop [ a owl:Restriction ;
                        owl:hasValue 1 ;
                        owl:onProperty :wheelchair_boarding ] ) ] .

:StopWithNoAccessibilityInformation a owl:Class ;
    rdfs:comment """
No accessibility information for the stop.
"""@en ;
    rdfs:subClassOf :ParentlessStop,
        :RecordWithAccessibilityInformation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ParentlessStop [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:hasValue 0 ;
                                    owl:onProperty :wheelchair_boarding ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty :wheelchair_boarding ] ) ] ) ] .

:StopWithNoAccessiblePathFromOutsideStation a owl:Class ;
    rdfs:comment """
There exists no accessible path from outside the station to the specific stop/platform.
"""@en ;
    rdfs:subClassOf :ChildStop,
        :RecordWithAccessibilityInformation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ChildStop [ a owl:Restriction ;
                        owl:hasValue 2 ;
                        owl:onProperty :wheelchair_boarding ] ) ] .

:StopWithNoWheelchairAccessibility a owl:Class ;
    rdfs:comment """
Wheelchair boarding is not possible at this stop. 
"""@en ;
    rdfs:subClassOf :ParentlessStop,
        :RecordWithAccessibilityInformation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ParentlessStop [ a owl:Restriction ;
                        owl:hasValue 2 ;
                        owl:onProperty :wheelchair_boarding ] ) ] .

:StopWithPartialWheelchairAccessibility a owl:Class ;
    rdfs:comment """
Some vehicles at this stop can be boarded by a rider in a wheelchair.
"""@en ;
    rdfs:subClassOf :ParentlessStop,
        :RecordWithAccessibilityInformation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ParentlessStop [ a owl:Restriction ;
                        owl:hasValue 1 ;
                        owl:onProperty :wheelchair_boarding ] ) ] .

:StopWithStopAccessInformation a owl:Class ;
    rdfs:comment """
Indicates how the stop is accessed for a particular station. Valid options are:

0 - The stop/platform cannot be directly accessed from the street network. It must be accessed from a station entrance if there is one defined for the station, otherwise the station itself. If there are pathways defined for the station, they must be used to access the stop/platform.
1 - Consuming applications should generate directions for access directly to the stop, independent of any entrances or pathways of the parent station.

When stop_access is empty, the access for the specified stop or platform is considered undefined.

Conditionally Forbidden:
- Forbidden for locations which are stations (location_type=1), entrances (location_type=2), generic nodes (location_type=3) or boarding areas (location_type=4).
- Forbidden if parent_station is empty.
- Optional otherwise.
"""@en ;
    rdfs:subClassOf :Stop .

:SubwayRoute a owl:Class ;
    rdfs:comment """
Any underground rail system within a metropolitan area.
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :route_type ] .

:TramRoute a owl:Class ;
    rdfs:comment """
Any light rail or street level system within a metropolitan area.
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 0 ;
            owl:onProperty :route_type ] .

:TripInDirectionA a owl:Class ;
    rdfs:comment """
Travel in one direction (e.g. outbound travel).
"""@en ;
    rdfs:subClassOf :Trip ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 0 ;
            owl:onProperty :direction_id ] .

:TripInDirectionB a owl:Class ;
    rdfs:comment """
Travel in one direction (e.g. outbound travel).
"""@en ;
    rdfs:subClassOf :Trip ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :direction_id ] .

:TripWithAtLeastOneBicycleSpace a owl:Class ;
    rdfs:comment """
Vehicle being used on this particular trip can accommodate at least one bicycle.
"""@en ;
    rdfs:subClassOf :Trip ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :bikes_allowed ] .

:TripWithAtLeastOneCarSpace a owl:Class ;
    rdfs:comment """
Vehicle being used on this particular trip can accommodate at least one car.
"""@en ;
    rdfs:subClassOf :Trip ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :cars_allowed ] .

:TripWithAtLeastOneWheelchairSpace a owl:Class ;
    rdfs:comment """
Vehicle being used on this particular trip can accommodate at least one rider in a wheelchair.
"""@en ;
    rdfs:subClassOf :RecordWithAccessibilityInformation,
        :Trip ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty :wheelchair_accessible ] .

:TripWithNoBicycleSpaces a owl:Class ;
    rdfs:comment """
No bicycles are allowed on this trip.
"""@en ;
    rdfs:subClassOf :Trip ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 2 ;
            owl:onProperty :bikes_allowed ] .

:TripWithNoBikesAllowedInformation a owl:Class ;
    rdfs:comment """
No bike information for the trip.
"""@en ;
    rdfs:subClassOf :Trip ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue 0 ;
                        owl:onProperty :bikes_allowed ] [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :bikes_allowed ] ) ] .

:TripWithNoCarSpaces a owl:Class ;
    rdfs:comment """
No cars are allowed on this trip.
"""@en ;
    rdfs:subClassOf :Trip ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 2 ;
            owl:onProperty :cars_allowed ] .

:TripWithNoCarsAllowedInformation a owl:Class ;
    rdfs:comment """
No car information for the trip.
"""@en ;
    rdfs:subClassOf :Trip ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue 0 ;
                        owl:onProperty :cars_allowed ] [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :cars_allowed ] ) ] .

:TripWithNoWheelchairAccessibility a owl:Class ;
    rdfs:comment """
No riders in wheelchairs can be accommodated on this trip.
"""@en ;
    rdfs:subClassOf :RecordWithAccessibilityInformation,
        :Trip ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 2 ;
            owl:onProperty :wheelchair_accessible ] .

:TripWithNoWheelchairAccessibilityInformation a owl:Class ;
    rdfs:comment """
No accessibility information for the trip.
"""@en ;
    rdfs:subClassOf :RecordWithAccessibilityInformation,
        :Trip ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue 0 ;
                        owl:onProperty :wheelchair_accessible ] [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty :wheelchair_accessible ] ) ] .

:TripWithShapeID a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :shape_id ],
        :Trip ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty :isRecordOf ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :TripFile [ a owl:Restriction ;
                                owl:onProperty :isFileOf ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( dcat:Dataset [ a owl:Restriction ;
                                                    owl:onProperty :hasFile ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:unionOf ( [ a owl:Class ;
                                                                        owl:intersectionOf ( :RouteFile [ a owl:Restriction ;
                                                                                    owl:onProperty :hasRecord ;
                                                                                    owl:someValuesFrom [ a owl:Class ;
                                                                                            owl:intersectionOf ( gtfs_linked:Route [ a owl:Class ;
                                                                                                        owl:unionOf ( [ a owl:Restriction ;
                                                                                                                    owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                    owl:onProperty :continuous_pickup ] [ a owl:Restriction ;
                                                                                                                    owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                    owl:onProperty :continuous_drop_off ] ) ] ) ] ] ) ] [ a owl:Class ;
                                                                        owl:intersectionOf ( :StopTimeFile [ a owl:Restriction ;
                                                                                    owl:onProperty :hasRecord ;
                                                                                    owl:someValuesFrom [ a owl:Class ;
                                                                                            owl:intersectionOf ( gtfs_linked:StopTime [ a owl:Class ;
                                                                                                        owl:unionOf ( [ a owl:Restriction ;
                                                                                                                    owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                    owl:onProperty :continuous_pickup ] [ a owl:Restriction ;
                                                                                                                    owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                                                                                                    owl:onProperty :continuous_drop_off ] ) ] ) ] ] ) ] ) ] ] ) ] ] ) ] ] .

:TrolleybusRoute a owl:Class ;
    rdfs:comment """
Electric buses that draw power from overhead wires using poles.
"""@en ;
    rdfs:subClassOf :Route ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue 11 ;
            owl:onProperty :route_type ] .

:WheelchairAccessibleEntrance a owl:Class ;
    rdfs:comment """
Station entrance is wheelchair accessible.
"""@en ;
    rdfs:subClassOf :EntranceOrExit,
        :RecordWithAccessibilityInformation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :EntranceOrExit [ a owl:Restriction ;
                        owl:hasValue 1 ;
                        owl:onProperty :wheelchair_boarding ] ) ] .

:currency_amount a owl:DatatypeProperty ;
    rdfs:comment """
A decimal value indicating a currency amount. The number of decimal places is specified by ISO 4217 for the accompanying Currency code. All financial calculations should be processed as decimal, currency, or another equivalent type suitable for financial calculations depending on the programming language used to consume data. Processing currency amounts as float is discouraged due to gains or losses of money during calculations.
"""@en ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/ISO_4217#Active_codes"^^xsd:string ;
    rdfs:subPropertyOf :field .

:currency_code a owl:DatatypeProperty ;
    rdfs:comment """
An ISO 4217 alphabetical currency code. For the list of current currency, refer to https://en.wikipedia.org/wiki/ISO_4217#Active_codes.
Example: CAD for Canadian dollars, EUR for euros or JPY for Japanese yen.
"""@en ;
    rdfs:range :currency_code_enum ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/ISO_4217#Active_codes"^^xsd:string ;
    rdfs:subPropertyOf :field .

:hasDataset a owl:ObjectProperty ;
    rdfs:domain :GTFSSchedule ;
    rdfs:range :Dataset .

:latitude a owl:DatatypeProperty ;
    rdfs:comment """
WGS84 latitude in decimal degrees. The value must be greater than or equal to -90.0 and less than or equal to 90.0.
Example: 41.890169 for the Colosseum in Rome.
"""@en ;
    rdfs:subPropertyOf <http://www.w3.org/2003/01/geo/wgs84_pos#latitude>,
        :field .

:local_time a owl:DatatypeProperty ;
    rdfs:comment """
Time in the HH:MM:SS format (H:MM:SS is also accepted). Represents a wall-clock time shown in the local time of the specified location.
"""@en ;
    rdfs:range xsd:time ;
    rdfs:subPropertyOf :field .

:longitude a owl:DatatypeProperty ;
    rdfs:comment """
WGS84 longitude in decimal degrees. The value must be greater than or equal to -180.0 and less than or equal to 180.0.
Example: 12.492269 for the Colosseum in Rome.
"""@en ;
    rdfs:subPropertyOf <http://www.w3.org/2003/01/geo/wgs84_pos#longitude>,
        :field .

gtfs_linked:Agency a owl:Class ;
    rdfs:subClassOf owl:Thing .

gtfs_linked:RouteType a owl:Class ;
    rdfs:subClassOf owl:Thing .

gtfs_linked:Service a owl:Class ;
    rdfs:subClassOf owl:Thing .

gtfs_linked:Station a owl:Class ;
    rdfs:subClassOf owl:Thing .

gtfs_linked:Stop a owl:Class ;
    rdfs:subClassOf owl:Thing .

gtfs_linked:Trip a owl:Class ;
    rdfs:subClassOf owl:Thing .

<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> a owl:Class ;
    rdfs:subClassOf owl:Thing .

foaf:Agent a owl:Class ;
    rdfs:subClassOf owl:Thing .

schema:email a owl:DatatypeProperty .

schema:url a rdfs:Datatype .

:BoardingArea a owl:Class ;
    rdfs:comment """
A specific location on a platform, where passengers can board and/or alight vehicles.
"""@en ;
    rdfs:subClassOf :ChildStop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Stop [ a owl:Restriction ;
                        owl:hasValue 4 ;
                        owl:onProperty :location_type ] ) ] .

:GTFSSchedule a owl:Class ;
    rdfs:comment """
GTFS Schedule is a feed specification that defines a common format for static public transportation information. It is composed of a collection of simple files, mostly text files (.txt) that are contained in a single ZIP file.

Each file describes a particular aspect of transit information such as stops, routes, trips, etc. At its most basic form, a GTFS Schedule dataset is composed of 7 files: agency.txt, routes.txt, trips.txt, stops.txt, stop_times.txt, calendar.txt and calendar_dates.txt.

Along with this basic set of files, additional (optional) files can also be grouped to provide information of other service elements, such as fares, translations, transfers, in-station pathways, etc. Currently there are more than 15 optional files that extend the basic elements of GTFS, including locations.geojson which introduced a new format besides text files (.txt) which can be used to represent geographical areas. 
"""@en ;
    rdfs:seeAlso "https://gtfs.org/documentation/overview/#gtfs-schedule"^^xsd:string ;
    rdfs:subClassOf :FeedSpecification .

:GenericNode a owl:Class ;
    rdfs:comment """
A location within a station, not matching any other location_type, that may be used to link together pathways define in pathways.txt.
"""@en ;
    rdfs:subClassOf :ChildStop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Stop [ a owl:Restriction ;
                        owl:hasValue 3 ;
                        owl:onProperty :location_type ] ) ] .

:Platform a owl:Class ;
    rdfs:comment """
Is called a platform when defined within a parent_station.
"""@en ;
    rdfs:subClassOf :StopOrPlatform ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :StopOrPlatform :ChildStop ) ] .

:Station a owl:Class ;
    rdfs:comment """
A physical structure or area that contains one or more platform.
"""@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_name ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_lat ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :stop_lon ] ) ],
        :ParentlessStop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Stop [ a owl:Restriction ;
                        owl:hasValue 1 ;
                        owl:onProperty :location_type ] ) ] ;
    skos:closeMatch gtfs_linked:Station .

:StopLocation a owl:Class ;
    rdfs:comment """
A location where passengers board or disembark from a transit vehicle.
"""@en ;
    rdfs:subClassOf :StopOrPlatform ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :StopOrPlatform :ParentlessStop ) ] .

:agency_email a owl:DatatypeProperty ;
    rdfs:comment """
Email address actively monitored by the agency’s customer service department. This email address should be a direct contact point where transit riders can reach a customer service representative at the agency.
"""@en ;
    rdfs:domain :Agency ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#agencytxt"^^xsd:string ;
    rdfs:subPropertyOf :email .

:agency_fare_url a owl:DatatypeProperty ;
    rdfs:comment """
URL of a web page where a rider can purchase tickets or other fare instruments for that agency, or a web page containing information about that agency's fares.
"""@en ;
    rdfs:domain :Agency ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#agencytxt"^^xsd:string ;
    rdfs:subPropertyOf :url .

:agency_lang a owl:DatatypeProperty ;
    rdfs:comment """
Primary language used by this transit agency. Should be provided to help GTFS consumers choose capitalization rules and other language-specific settings for the dataset.
"""@en ;
    rdfs:domain :Agency ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#agencytxt"^^xsd:string ;
    rdfs:subPropertyOf :language_code .

:agency_name a owl:DatatypeProperty ;
    rdfs:comment """
Full name of the transit agency.
"""@en ;
    rdfs:domain :Agency ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#agencytxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:agency_phone a owl:DatatypeProperty ;
    rdfs:comment """
A voice telephone number for the specified agency. This field is a string value that presents the telephone number as typical for the agency's service area. It may contain punctuation marks to group the digits of the number. Dialable text (for example, TriMet's "503-238-RIDE") is permitted, but the field must not contain any other descriptive text.
"""@en ;
    rdfs:domain :Agency ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#agencytxt"^^xsd:string ;
    rdfs:subPropertyOf :phone_number .

:agency_timezone a owl:DatatypeProperty ;
    rdfs:comment """
Timezone where the transit agency is located. If multiple agencies are specified in the dataset, each must have the same agency_timezone.
"""@en ;
    rdfs:domain :Agency ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#agencytxt"^^xsd:string ;
    rdfs:subPropertyOf :timezone .

:agency_url a owl:DatatypeProperty ;
    rdfs:comment """
URL of the transit agency.
"""@en ;
    rdfs:domain :Agency ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#agencytxt"^^xsd:string ;
    rdfs:subPropertyOf :url .

:bikes_allowed_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 ) ] .

:block_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies the block to which the trip belongs. A block consists of a single trip or many sequential trips made using the same vehicle, defined by shared service days and block_id. A block_id may have trips with different service days, making distinct blocks. See the example below. To provide in-seat transfers information, transfers of transfer_type 4 should be provided instead.
"""@en ;
    rdfs:domain :Trip ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#tripstxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:calendar_dates_date a owl:DatatypeProperty ;
    rdfs:comment """
Date when service exception occurs.
"""@en ;
    rdfs:domain :Service ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendar_datestxt"^^xsd:string ;
    rdfs:subPropertyOf :date .

:cars_allowed_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 ) ] .

:cemv_support_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 ) ] .

:color_pattern a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9A-F]{6}$"^^xsd:string ] ) ] .

:continuous_drop_off_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 3 ) ] .

:continuous_pickup_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 3 ) ] .

:currency_code_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "AED"^^xsd:string "AFN"^^xsd:string "ALL"^^xsd:string "AMD"^^xsd:string "AOA"^^xsd:string "ARS"^^xsd:string "AUD"^^xsd:string "AWG"^^xsd:string "AZN"^^xsd:string "BAM"^^xsd:string "BBD"^^xsd:string "BDT"^^xsd:string "BHD"^^xsd:string "BIF"^^xsd:string "BMD"^^xsd:string "BND"^^xsd:string "BOB"^^xsd:string "BOV"^^xsd:string "BRL"^^xsd:string "BSD"^^xsd:string "BTN"^^xsd:string "BWP"^^xsd:string "BYN"^^xsd:string "BZD"^^xsd:string "CAD"^^xsd:string "CDF"^^xsd:string "CHE"^^xsd:string "CHF"^^xsd:string "CHW"^^xsd:string "CLF"^^xsd:string "CLP"^^xsd:string "CNY"^^xsd:string "COP"^^xsd:string "COU"^^xsd:string "CRC"^^xsd:string "CUP"^^xsd:string "CVE"^^xsd:string "CZK"^^xsd:string "DJF"^^xsd:string "DKK"^^xsd:string "DOP"^^xsd:string "DZD"^^xsd:string "EGP"^^xsd:string "ERN"^^xsd:string "ETB"^^xsd:string "EUR"^^xsd:string "FJD"^^xsd:string "FKP"^^xsd:string "GBP"^^xsd:string "GEL"^^xsd:string "GHS"^^xsd:string "GIP"^^xsd:string "GMD"^^xsd:string "GNF"^^xsd:string "GTQ"^^xsd:string "GYD"^^xsd:string "HKD"^^xsd:string "HNL"^^xsd:string "HTG"^^xsd:string "HUF"^^xsd:string "IDR"^^xsd:string "ILS"^^xsd:string "INR"^^xsd:string "IQD"^^xsd:string "IRR"^^xsd:string "ISK"^^xsd:string "JMD"^^xsd:string "JOD"^^xsd:string "JPY"^^xsd:string "KES"^^xsd:string "KGS"^^xsd:string "KHR"^^xsd:string "KMF"^^xsd:string "KPW"^^xsd:string "KRW"^^xsd:string "KWD"^^xsd:string "KYD"^^xsd:string "KZT"^^xsd:string "LAK"^^xsd:string "LBP"^^xsd:string "LKR"^^xsd:string "LRD"^^xsd:string "LSL"^^xsd:string "LYD"^^xsd:string "MAD"^^xsd:string "MDL"^^xsd:string "MGA"^^xsd:string "MKD"^^xsd:string "MMK"^^xsd:string "MNT"^^xsd:string "MOP"^^xsd:string "MRU"^^xsd:string "MUR"^^xsd:string "MVR"^^xsd:string "MWK"^^xsd:string "MXN"^^xsd:string "MXV"^^xsd:string "MYR"^^xsd:string "MZN"^^xsd:string "NAD"^^xsd:string "NGN"^^xsd:string "NIO"^^xsd:string "NOK"^^xsd:string "NPR"^^xsd:string "NZD"^^xsd:string "OMR"^^xsd:string "PAB"^^xsd:string "PEN"^^xsd:string "PGK"^^xsd:string "PHP"^^xsd:string "PKR"^^xsd:string "PLN"^^xsd:string "PYG"^^xsd:string "QAR"^^xsd:string "RON"^^xsd:string "RSD"^^xsd:string "RUB"^^xsd:string "RWF"^^xsd:string "SAR"^^xsd:string "SBD"^^xsd:string "SCR"^^xsd:string "SDG"^^xsd:string "SEK"^^xsd:string "SGD"^^xsd:string "SHP"^^xsd:string "SLE"^^xsd:string "SOS"^^xsd:string "SRD"^^xsd:string "SSP"^^xsd:string "STN"^^xsd:string "SVC"^^xsd:string "SYP"^^xsd:string "SZL"^^xsd:string "THB"^^xsd:string "TJS"^^xsd:string "TMT"^^xsd:string "TND"^^xsd:string "TOP"^^xsd:string "TRY"^^xsd:string "TTD"^^xsd:string "TWD"^^xsd:string "TZS"^^xsd:string "UAH"^^xsd:string "UGX"^^xsd:string "USD"^^xsd:string "USN"^^xsd:string "UYI"^^xsd:string "UYU"^^xsd:string "UYW"^^xsd:string "UZS"^^xsd:string "VED"^^xsd:string "VES"^^xsd:string "VND"^^xsd:string "VUV"^^xsd:string "WST"^^xsd:string "XAD"^^xsd:string "XAF"^^xsd:string "XAG"^^xsd:string "XAU"^^xsd:string "XBA"^^xsd:string "XBB"^^xsd:string "XBC"^^xsd:string "XBD"^^xsd:string "XCD"^^xsd:string "XCG"^^xsd:string "XDR"^^xsd:string "XOF"^^xsd:string "XPD"^^xsd:string "XPF"^^xsd:string "XPT"^^xsd:string "XSU"^^xsd:string "XTS"^^xsd:string "XUA"^^xsd:string "XXX"^^xsd:string "YER"^^xsd:string "ZAR"^^xsd:string "ZMW"^^xsd:string "ZWG"^^xsd:string ) ] .

:direction_id_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 ) ] .

:drop_off_booking_rule_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies the alighting booking rule at this stop time.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:drop_off_type_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 3 ) ] .

:email a owl:DatatypeProperty ;
    rdfs:comment """
An email address.
Example: example@example.com
"""@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:email,
        :field .

:end_date a owl:DatatypeProperty ;
    rdfs:comment """
End service day for the service interval. This service day is included in the interval.
"""@en ;
    rdfs:domain :Service ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendartxt"^^xsd:string ;
    rdfs:subPropertyOf :date .

:exception_type a owl:DatatypeProperty ;
    rdfs:comment """
Indicates whether service is available on the date specified in the date field. Valid options are:

1 - Service has been added for the specified date.
2 - Service has been removed for the specified date.Example: Suppose a route has one set of trips available on holidays and another set of trips available on all other days. One service_id could correspond to the regular service schedule and another service_id could correspond to the holiday schedule. For a particular holiday, the calendar_dates.txt file could be used to add the holiday to the holiday service_id and to remove the holiday from the regular service_id schedule.
"""@en ;
    rdfs:domain :Service ;
    rdfs:range :exception_type_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendar_datestxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:exception_type_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 1 2 ) ] .

:friday a owl:DatatypeProperty ;
    rdfs:comment """
Functions in the same way as monday except applies to Tuesdays
"""@en ;
    rdfs:domain :Service ;
    rdfs:range :weekday_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendartxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:language_code a owl:DatatypeProperty ;
    rdfs:comment """
An IETF BCP 47 language code. For an introduction to IETF BCP 47, refer to http://www.rfc-editor.org/rfc/bcp/bcp47.txt and https://www.w3.org/International/articles/language-tags/.
Example: en for English, en-US for American English or de for German.
"""@en ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "http://www.rfc-editor.org/rfc/bcp/bcp47.txt"^^xsd:string,
        "https://www.w3.org/International/articles/language-tags/"^^xsd:string ;
    rdfs:subPropertyOf :field .

:level_id a owl:DatatypeProperty ;
    rdfs:comment """
Level of the location. The same level may be used by multiple unlinked stations.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :field .

:location_type_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 3 4 ) ] .

:monday a owl:DatatypeProperty ;
    rdfs:comment """
Indicates whether the service operates on all Mondays in the date range specified by the start_date and end_date fields. Note that exceptions for particular dates may be listed in calendar_dates.txt. Valid options are:

1 - Service is available for all Mondays in the date range.
0 - Service is not available for Mondays in the date range.
"""@en ;
    rdfs:domain :Service ;
    rdfs:range :weekday_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendartxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:network_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies a group of routes. Multiple rows in routes.txt may have the same network_id.
"""@en ;
    rdfs:domain :Route ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:num_float a owl:DatatypeProperty ;
    rdfs:comment """
A floating point number.
"""@en ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf :field .

:phone_number a owl:DatatypeProperty ;
    rdfs:comment """
A phone number.
"""@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :field .

:pickup_booking_rule_id a owl:DatatypeProperty ;
    rdfs:comment """
Identifies the boarding booking rule at this stop time.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :id .

:pickup_type_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 3 ) ] .

:platform_code a owl:DatatypeProperty ;
    rdfs:comment """
Platform identifier for a platform stop (a stop belonging to a station). This should be just the platform identifier (eg. "G" or "3"). Words like “platform” or "track" (or the feed’s language-specific equivalent) should not be included. This allows feed consumers to more easily internationalize and localize the platform identifier into other languages.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:route_color a owl:DatatypeProperty ;
    rdfs:comment """
Route color designation that matches public facing material. Defaults to white (FFFFFF) when omitted or left empty. The color difference between route_color and route_text_color should provide sufficient contrast when viewed on a black and white screen.
"""@en ;
    rdfs:domain :Route ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subPropertyOf :color .

:route_desc a owl:DatatypeProperty ;
    rdfs:comment """
Description of a route that provides useful, quality information. Should not be a duplicate of route_short_name or route_long_name. 
"""@en ;
    rdfs:domain :Route ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:route_sort_order a owl:DatatypeProperty ;
    rdfs:comment """
Orders the routes in a way which is ideal for presentation to customers. Routes with smaller route_sort_order values should be displayed first.
"""@en ;
    rdfs:domain :Route ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subPropertyOf :num_int .

:route_text_color a owl:DatatypeProperty ;
    rdfs:comment """
Legible color to use for text drawn against a background of route_color. Defaults to black (000000) when omitted or left empty. The color difference between route_color and route_text_color should provide sufficient contrast when viewed on a black and white screen.
"""@en ;
    rdfs:domain :Route ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subPropertyOf :color .

:route_type_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 2 3 4 5 6 7 11 12 ) ] .

:route_url a owl:DatatypeProperty ;
    rdfs:comment """
URL of a web page about the particular route. Should be different from the agency.agency_url value.
"""@en ;
    rdfs:domain :Route ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#routestxt"^^xsd:string ;
    rdfs:subPropertyOf :url .

:saturday a owl:DatatypeProperty ;
    rdfs:comment """
Functions in the same way as monday except applies to Tuesdays
"""@en ;
    rdfs:domain :Service ;
    rdfs:range :weekday_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendartxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:shape_dist_traveled a owl:DatatypeProperty ;
    rdfs:comment """
Actual distance traveled along the associated shape, from the first stop to the stop specified in this record. This field specifies how much of the shape to draw between any two stops during a trip. Must be in the same units used in shapes.txt. Values used for shape_dist_traveled must increase along with stop_sequence; they must not be used to show reverse travel along a route.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :num_float .

:start_date a owl:DatatypeProperty ;
    rdfs:comment """
Start service day for the service interval.
"""@en ;
    rdfs:domain :Service ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendartxt"^^xsd:string ;
    rdfs:subPropertyOf :date .

:stop_access_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 ) ] .

:stop_code a owl:DatatypeProperty ;
    rdfs:comment """
Name of the location. The stop_name should match the agency's rider-facing name for the location as printed on a timetable, published online, or represented on signage. For translations into other languages, use translations.txt.

When the location is a boarding area (location_type=4), the stop_name should contains the name of the boarding area as displayed by the agency. It could be just one letter (like on some European intercity railway stations), or text like “Wheelchair boarding area” (NYC’s Subway) or “Head of short trains” (Paris’ RER).
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:stop_desc a owl:DatatypeProperty ;
    rdfs:comment """
Description of the location that provides useful, quality information. Should not be a duplicate of stop_name.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:stop_headsign a owl:DatatypeProperty ;
    rdfs:comment """
Text that appears on signage identifying the trip's destination to riders. This field overrides the default trips.trip_headsign when the headsign changes between stops. If the headsign is displayed for an entire trip, trips.trip_headsign should be used instead.

A stop_headsign value specified for one stop_time does not apply to subsequent stop_times in the same trip. If you want to override the trip_headsign for multiple stop_times in the same trip, the stop_headsign value must be repeated in each stop_time row.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :text .

:stop_sequence a owl:DatatypeProperty ;
    rdfs:comment """
Order of stops, location groups, or GeoJSON locations for a particular trip. The values must increase along the trip but do not need to be consecutive. Example: The first location on the trip could have a stop_sequence=1, the second location on the trip could have a stop_sequence=23, the third location could have a stop_sequence=40, and so on.

Travel within the same location group or GeoJSON location requires two records in stop_times.txt with the same location_group_id or location_id.
"""@en ;
    rdfs:domain :StopTime ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stoptxt"^^xsd:string ;
    rdfs:subPropertyOf :num_int .

:stop_timezone a owl:DatatypeProperty ;
    rdfs:comment """
Timezone of the location. If the location has a parent station, it inherits the parent station’s timezone instead of applying its own. Stations and parentless stops with empty stop_timezone inherit the timezone specified by agency.agency_timezone. The times provided in stop_times.txt are in the timezone specified by agency.agency_timezone, not stop_timezone. This ensures that the time values in a trip always increase over the course of a trip, regardless of which timezones the trip crosses.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :timezone .

:stop_url a owl:DatatypeProperty ;
    rdfs:comment """
URL of a web page about the location. This should be different from the agency.agency_url and the routes.route_url field values.
"""@en ;
    rdfs:domain :Stop ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#stopstxt"^^xsd:string ;
    rdfs:subPropertyOf :url .

:sunday a owl:DatatypeProperty ;
    rdfs:comment """
Functions in the same way as monday except applies to Sundays.
"""@en ;
    rdfs:domain :Service ;
    rdfs:range :weekday_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendartxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:thursday a owl:DatatypeProperty ;
    rdfs:comment """
Functions in the same way as monday except applies to Tuesdays
"""@en ;
    rdfs:domain :Service ;
    rdfs:range :weekday_enum ;
    rdfs:seeAlso "https://gtfs.org/documentation/schedule/reference/#calendartxt"^^xsd:string ;
    rdfs:subPropertyOf :enum .

:timepoint_enum a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( 0 1 ) ] .

