<rdfs:Datatype rdf:about="#ContinuousPickupDatatype">
  <owl:equivalentClass>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</rdf:first>
