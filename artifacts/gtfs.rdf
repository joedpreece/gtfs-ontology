<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.transit.ac.uk/ontologies/gtfs"
         xmlns="http://www.transit.ac.uk/ontologies/gtfs#">

<owl:Ontology rdf:about="http://www.transit.ac.uk/ontologies/gtfs">
  <rdfs:comment xml:lang="en">An OWL ontology describing entities, relationships, and data structures found in the General Transit Feed Specification (GTFS).</rdfs:comment>
  <rdfs:label xml:lang="en">The GTFS Ontology</rdfs:label>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.1.0</owl:versionInfo>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#hasAgency">
  <rdfs:domain rdf:resource="#AgencyFile"/>
  <rdfs:range rdf:resource="#Agency"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#agency_id">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Agency"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identifies a transit brand which is often synonymous with a transit agency. Note that in some cases, such as when a single agency operates multiple separate services, agencies and brands are distinct. This document uses the term "agency" in place of "brand". A dataset may contain data from multiple agencies. </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#agency_name">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Agency"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Full name of the transit agency.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#agency_url">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Agency"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">URL of the transit agency.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#agency_timezone">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Agency"/>
  <rdfs:range rdf:resource="#Timezone"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Timezone where the transit agency is located. If multiple agencies are specified in the dataset, each must have the same agency_timezone.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#agency_lang">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Agency"/>
  <rdfs:range rdf:resource="#LanguageCode"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The language of an agency.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#agency_phone">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Agency"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The phone number of an agency.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#agency_fare_url">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Agency"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The URL of an agency's fare rules.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#agency_email">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Agency"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The email address of an agency.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cemv_support">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Agency"/>
  <rdfs:range rdf:resource="#CEMVSupportType"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The agency supports CEMV.</rdfs:comment>
</owl:DatatypeProperty>

<owl:Class rdf:about="#AgencyFile">
  <rdfs:subClassOf rdf:resource="#File"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasAgency"/>
      <owl:someValuesFrom rdf:resource="#Agency"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transit agencies with service represented in this dataset.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Agency">
  <rdfs:subClassOf rdf:resource="#Record"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#agency_name"/>
          <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
          <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#agency_url"/>
          <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
          <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#agency_timezone"/>
          <owl:onClass rdf:resource="#Timezone"/>
          <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Dataset">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A complete set of files defined by this specification reference. Altering the dataset creates a new version of the dataset. Datasets should be published at a public, permanent URL, including the zip file name. (e.g., https://www.agency.org/gtfs/gtfs.zip).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Record">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A basic data structure comprised of a number of different field values describing a single entity (e.g. transit agency, stop, route, etc.). Represented, in a table, as a row.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Field">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A property of an object or entity. Represented, in a table, as a column. The field exists if added in a file as a header. It may or may not have field values defined.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FieldValue">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An individual entry in a field. Represented, in a table, as a single cell.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#File">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#StopFile">
  <rdfs:subClassOf rdf:resource="#File"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stops where vehicles pick up or drop off riders. Also defines stations and station entrances.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RouteFile">
  <rdfs:subClassOf rdf:resource="#File"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transit routes. A route is a group of trips that are displayed to riders as a single service.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TripFile">
  <rdfs:subClassOf rdf:resource="#File"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trips for each route. A trip is a sequence of two or more stops that occur during a specific time period.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#StopTimeFile">
  <rdfs:subClassOf rdf:resource="#File"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Times that a vehicle arrives at and departs from stops for each trip.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CalendarFile">
  <rdfs:subClassOf rdf:resource="#File"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Service dates specified using a weekly schedule with start and end dates.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CalendarDateFile">
  <rdfs:subClassOf rdf:resource="#File"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exceptions for the services defined in the calendar.txt.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Stop">
  <rdfs:subClassOf rdf:resource="#Record"/>
</owl:Class>

<owl:Class rdf:about="#Route">
  <rdfs:subClassOf rdf:resource="#Record"/>
</owl:Class>

<owl:Class rdf:about="#Trip">
  <rdfs:subClassOf rdf:resource="#Record"/>
</owl:Class>

<owl:Class rdf:about="#StopTime">
  <rdfs:subClassOf rdf:resource="#Record"/>
</owl:Class>

<owl:Class rdf:about="#Calendar">
  <rdfs:subClassOf rdf:resource="#Record"/>
</owl:Class>

<owl:Class rdf:about="#AgencyFileWithMultipleAgents">
  <rdfs:subClassOf rdf:resource="#AgencyFile"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#AgencyFile"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasAgency"/>
          <owl:onClass rdf:resource="#Agency"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<rdfs:Datatype rdf:about="#LanguageCode">
  <owl:equivalentClass>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EN</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </owl:equivalentClass>
</rdfs:Datatype>

<rdfs:Datatype rdf:about="#Timezone">
  <owl:equivalentClass>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Europe/London</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </owl:equivalentClass>
</rdfs:Datatype>

<rdfs:Datatype rdf:about="#CEMVSupportType">
  <owl:equivalentClass>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </owl:equivalentClass>
</rdfs:Datatype>


</rdf:RDF>
