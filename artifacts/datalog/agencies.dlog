[gtfs:Violation, rdf:type, owl:Class] .

# Multiple agency file if it has more than one agency.
[?f, rdf:type, gtfs:AgencyFileWithMultipleAgencies] :-
    [?f, rdf:type, gtfs:AgencyFile] ,
    [?f, gtfs:hasAgency, ?a1],
    [?f, gtfs:hasAgency, ?a2],
    FILTER(?a1 != ?a2).

# Single‑agency if it has at least one agency AND it is not multi agency file.
[?f, rdf:type, gtfs:AgencyFileWithSingleAgency] :-
    [?f, rdf:type, gtfs:AgencyFile] ,
    [ ?f, gtfs:hasAgency, ?a ],
    NOT EXISTS ?x IN (
        [?f, rdf:type, gtfs:AgencyFileWithMultipleAgencies]
    ).

#    NOT [ ?f, rdf:type, gtfs:AgencyFileWithMultipleAgencies ] .

# Raise a violation if the file is neither a single or multiple agency file.
[?f, rdf:type, gtfs:Violation] :-
    [?f, rdf:type, gtfs:AgencyFile] ,
    NOT EXISTS ?x IN ([ ?f, rdf:type, gtfs:AgencyFileWithSingleAgency ]) ,
    NOT EXISTS ?y IN ([ ?f, rdf:type, gtfs:AgencyFileWithMultipleAgencies ]) .

# Check for the required fields.
[?a, rdf:type, gtfs:Violation] :-
    [?a, rdf:type, gtfs:Agency] ,
    NOT EXISTS ?n IN ([?a, gtfs:agency_name, ?sn]),
    NOT EXISTS ?u IN ([?a, gtfs:agency_url, ?u]),
    NOT EXISTS ?t IN ([?a, gtfs:agency_timezone, ?t]).

# Check if agencies within a multiple agency file have unique ids.
[?a, rdf:type, gtfs:Violation] :-
    [?f, rdf:type, gtfs:AgencyFileWithMultipleAgencies],
    [?f, gtfs:hasAgency, ?a],
    NOT EXISTS ?id IN ([?a, gtfs:agency_id, ?id]).

[?a, gtfs:cemv_support_description, gtfs:CEMVSupportTypeDescription0] :-
    [?a, rdf:type, gtfs:Agency],
    [?a, gtfs:cemv_support, 0].

[?a, gtfs:cemv_support_description, gtfs:CEMVSupportTypeDescription1] :-
    [?a, rdf:type, gtfs:Agency],
    [?a, gtfs:cemv_support, 1].

[?a, gtfs:cemv_support_description, gtfs:CEMVSupportTypeDescription2] :-
    [?a, rdf:type, gtfs:Agency],
    [?a, gtfs:cemv_support, 2].