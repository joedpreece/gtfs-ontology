[gtfs:Violation, rdf:type, owl:Class] .

[gtfs:AgencyFileWithMultipleAgencies, rdf:type, owl:Class] .

[?f, rdf:type, gtfs:AgencyFileWithMultipleAgencies] :-
    [?f, gtfs:hasAgency, ?a1],
    [?f, gtfs:hasAgency, ?a2],
    FILTER(?a1 != ?a2).

# Single‑agency if it has at least one agency AND it is not multi
[?f, rdf:type, gtfs:AgencyFileWithSingleAgency] :-
    [ ?f, gtfs:hasAgency, ?a ],
    NOT [ ?f, rdf:type, gtfs:AgencyFileWithMultipleAgencies ] .
