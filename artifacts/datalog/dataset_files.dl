# Rule 1
## A `Dataset` is a `Violation` if it has no `AgencyFile`.
[?d, gtfs:violationDetail, "This `Dataset` must have at least one `AgencyFile`."] ,
[?d, rdf:type, gtfs:Violation] :-
    [?d, rdf:type, gtfs:Dataset] ,
    NOT EXISTS ?af IN (
        [?af, rdf:type, gtfs:AgencyFile] ,
        [?d, gtfs:hasFile, ?af]
    ) .

# Rule 2
# A `Dataset` is a `Violation` if it has more than one `AgencyFile`.
[?d, gtfs:violationDetail, "This `Dataset` has more than one `AgencyFile`."] ,
[?d, rdf:type, gtfs:Violation] :-
    [?d, rdf:type, gtfs:Dataset],
    [?d, gtfs:hasFile, ?af1],
    [?af1, rdf:type, gtfs:AgencyFile],
    [?d, gtfs:hasFile, ?af2],
    [?af2, rdf:type, gtfs:AgencyFile],
    FILTER(?af1 != ?af2) .


# Rule 3
# An `AgencyFile` is an `AgencyFileWithMultipleAgencies` if it has more than one `Agency`.
[?f, rdf:type, gtfs:AgencyFileWithMultipleAgencies] :-
    [?f, rdf:type, gtfs:AgencyFile] ,
    [?f, gtfs:hasAgency, ?a1],
    [?f, gtfs:hasAgency, ?a2],
    FILTER(?a1 != ?a2).

# Rule 4
# An `AgencyFile` is an `AgencyFileWithSingleAgency` if it has exactly one `Agency`.
[?f, rdf:type, gtfs:AgencyFileWithSingleAgency] :-
    [?f, rdf:type, gtfs:AgencyFile] ,
    [ ?f, gtfs:hasAgency, ?a ],
    NOT EXISTS ?x IN (
        [?f, rdf:type, gtfs:AgencyFileWithMultipleAgencies]
    ).

# Rule 5
# An `AgencyFile` is a violation if it is neither a `AgencyFileWithSingleAgency` nor a `AgencyFileWithMultipleAgencies`.
[?f, rdf:type, gtfs:Violation] :-
    [?f, rdf:type, gtfs:AgencyFile] ,
    NOT EXISTS ?x IN ([ ?f, rdf:type, gtfs:AgencyFileWithSingleAgency ]) ,
    NOT EXISTS ?y IN ([ ?f, rdf:type, gtfs:AgencyFileWithMultipleAgencies ]) .

